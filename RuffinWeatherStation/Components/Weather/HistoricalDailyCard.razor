@using RuffinWeatherStation.Models

<div class="card mt-3" style="max-width: 400px;">
    <div class="card-header bg-primary text-white">
        <h3 class="mb-0">Historical High / Low</h3>
        <small class="rainfall-card-subtitle">Daily record for selected date</small>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label" for="historicalDateInput">Date</label>
            <input id="historicalDateInput"
                   type="date"
                   class="form-control"
                   value="@SelectedDate.ToString("yyyy-MM-dd")"
                   @onchange="OnDateChanged" />
            <small class="text-muted d-block mt-1">Location: @Location</small>
        </div>

        @if (IsLoading)
        {
            <p class="text-muted mb-0">Loading historical record...</p>
        }
        else if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-warning mb-0">@ErrorMessage</div>
        }
        else if (Record?.HasData == true)
        {
            <div class="row text-center mb-3">
                <div class="col-6">
                    <h6 class="mb-1">High</h6>
                    <div class="fw-semibold">@FormatDouble(Record.High?.Value)C</div>
                    <small class="text-muted">@FormatTemperatureF(Record.High?.Value)F</small>
                    <div><small class="text-muted">@FormatHistoricDate(Record.High?.Date)</small></div>
                </div>
                <div class="col-6">
                    <h6 class="mb-1">Low</h6>
                    <div class="fw-semibold">@FormatDouble(Record.Low?.Value)C</div>
                    <small class="text-muted">@FormatTemperatureF(Record.Low?.Value)F</small>
                    <div><small class="text-muted">@FormatHistoricDate(Record.Low?.Date)</small></div>
                </div>
            </div>

            <div class="text-muted">
                <small>Updated: @(Record.UpdatedAt.HasValue ? FormatDateTimeForUserWithTimezone(Record.UpdatedAt.Value) : "N/A")</small>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                No historical record for this date.
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public DateTime SelectedDate { get; set; }
    [Parameter] public string Location { get; set; } = "backyard";
    [Parameter] public EventCallback<ChangeEventArgs> OnDateChanged { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public HistoricalDailyRecordResponse? Record { get; set; }
    [Parameter] public Func<double?, string> FormatDouble { get; set; } = _ => "N/A";
    [Parameter] public Func<double?, string> FormatTemperatureF { get; set; } = _ => "N/A";
    [Parameter] public Func<string?, string> FormatHistoricDate { get; set; } = _ => "N/A";
    [Parameter] public Func<DateTime, string> FormatDateTimeForUserWithTimezone { get; set; } = value => value.ToString("g");
}
