@using RuffinWeatherStation.Models

@if (IsLoading)
{
    <div class="alert alert-light border mb-4">
        <strong>Weather Attention Alerts:</strong> Checking latest NWS snapshot...
    </div>
}
else if (!string.IsNullOrWhiteSpace(LoadError))
{
    <div class="alert alert-warning mb-4">
        <strong>Weather Attention Alerts:</strong> @LoadError
    </div>
}
else if (Alerts?.Any() == true)
{
    <div class="card border-danger mb-4">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Weather Attention Alerts</h4>
            <span class="badge text-bg-light">@Alerts.Count</span>
        </div>
        <div class="card-body">
            @if (Summary?.SnapshotFetchedAtUtc.HasValue == true)
            {
                <p class="text-muted mb-2">
                    Snapshot fetched: @FormatDateTimeForUserWithTimezone(Summary.SnapshotFetchedAtUtc.Value)
                    @if (Summary.IsSnapshotExpired)
                    {
                        <span class="badge text-bg-secondary ms-2">Snapshot Expired</span>
                    }
                    else
                    {
                        <span class="badge text-bg-success ms-2">Snapshot Active</span>
                    }
                </p>
            }

            <div class="d-flex flex-column gap-3">
                @foreach (var alert in Alerts)
                {
                    <div class="border rounded p-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <h5 class="mb-1">@alert.Event</h5>
                                @if (!string.IsNullOrWhiteSpace(alert.Headline))
                                {
                                    <div class="text-muted">@alert.Headline</div>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <span class="badge @GetSeverityBadgeClass(alert.Severity)">@alert.Severity</span>
                                <span class="badge @(alert.IsActive ? "text-bg-success" : "text-bg-secondary")">@(alert.IsActive ? "Active" : "Expired")</span>
                            </div>
                        </div>

                        <div class="row gy-2 small">
                            <div class="col-md-4 col-6"><strong>Urgency:</strong> @alert.Urgency</div>
                            <div class="col-md-4 col-6"><strong>Certainty:</strong> @alert.Certainty</div>
                            <div class="col-md-4 col-12"><strong>Onset:</strong> @FormatNullableDateTimeForUserWithTimezone(alert.OnsetUtc)</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(alert.Instruction))
                        {
                            <div class="alert alert-warning py-2 mt-2 mb-0">
                                <strong>Instruction:</strong> @alert.Instruction
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? LoadError { get; set; }
    [Parameter] public List<NwsAlertSnapshotData> Alerts { get; set; } = new();
    [Parameter] public NwsAlertSummaryData? Summary { get; set; }
    [Parameter] public Func<DateTime, string> FormatDateTimeForUserWithTimezone { get; set; } = value => value.ToString("g");
    [Parameter] public Func<DateTime?, string> FormatNullableDateTimeForUserWithTimezone { get; set; } = _ => "n/a";
    [Parameter] public Func<string, string> GetSeverityBadgeClass { get; set; } = _ => "text-bg-secondary";
}
