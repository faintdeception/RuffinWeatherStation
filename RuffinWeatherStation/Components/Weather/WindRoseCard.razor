@using RuffinWeatherStation.Models

<div class="card mt-3 wind-gust-card" style="max-width: 400px;">
    <div class="card-header bg-secondary text-white">
        <h3 class="mb-0">Latest Wind Rose</h3>
        <small class="rainfall-card-subtitle">Strength and direction from the most recent sample</small>
    </div>
    <div class="card-body">
        @if (Measurement?.Fields != null)
        {
            var latestWindSpeed = GetLatestWindSpeed(Measurement);
            var normalizedDirection = NormalizeWindDirection(Measurement.Fields.WindDirection);
            var windDirectionCardinal = GetWindDirectionCardinalLabel(Measurement.Fields.WindDirectionCardinal, normalizedDirection);

            <div class="wind-rose-shell">
                <svg class="wind-rose-chart" viewBox="0 0 220 220" role="img" aria-label="Wind rose chart">
                    <circle class="wind-rose-ring" cx="110" cy="110" r="88" />
                    <circle class="wind-rose-ring" cx="110" cy="110" r="60" />
                    <circle class="wind-rose-ring" cx="110" cy="110" r="32" />

                    <line class="wind-rose-axis" x1="110" y1="18" x2="110" y2="202" />
                    <line class="wind-rose-axis" x1="18" y1="110" x2="202" y2="110" />

                    <text class="wind-rose-label" x="110" y="12" text-anchor="middle">N</text>
                    <text class="wind-rose-label" x="210" y="114" text-anchor="middle">E</text>
                    <text class="wind-rose-label" x="110" y="214" text-anchor="middle">S</text>
                    <text class="wind-rose-label" x="10" y="114" text-anchor="middle">W</text>

                    <g class="wind-gust-vector" style="transform: rotate(@($"{normalizedDirection:F1}deg")); transform-origin: 110px 110px;">
                        <polygon class="wind-gust-petal" points="@GetWindRosePetalPoints(latestWindSpeed)" />
                    </g>

                    <circle class="wind-rose-center" cx="110" cy="110" r="5" />
                </svg>

                <div class="wind-rose-details text-center mt-2">
                    <div class="display-6 mb-1">@latestWindSpeed.ToString("0.0") m/s</div>
                    <div class="fw-semibold">From @windDirectionCardinal (@Math.Round(normalizedDirection, 0)°)</div>
                    @if (!string.IsNullOrWhiteSpace(ObservedLabel))
                    {
                        <small class="text-muted">Observed @ObservedLabel</small>
                    }
                </div>
            </div>
        }
        else
        {
            <p class="text-muted text-center mb-0">Wind data is not available yet.</p>
        }
    </div>
</div>

@code {
    [Parameter]
    public TemperatureMeasurement? Measurement { get; set; }

    [Parameter]
    public string? ObservedLabel { get; set; }

    private static double GetLatestWindSpeed(TemperatureMeasurement currentMeasurement)
    {
        return Math.Max(currentMeasurement.Fields?.WindSpeed ?? 0, 0);
    }

    private static double NormalizeWindDirection(double rawDirection)
    {
        var normalized = rawDirection % 360;
        return normalized < 0 ? normalized + 360 : normalized;
    }

    private static string GetWindDirectionCardinalLabel(string? currentCardinal, double normalizedDirection)
    {
        if (!string.IsNullOrWhiteSpace(currentCardinal))
            return currentCardinal;

        string[] cardinalDirections = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"];
        var index = (int)Math.Round(normalizedDirection / 22.5, MidpointRounding.AwayFromZero) % cardinalDirections.Length;
        return cardinalDirections[index];
    }

    private static string GetWindRosePetalPoints(double speed)
    {
        const double center = 110;
        const double minRadius = 24;
        const double maxRadius = 86;
        const double referenceSpeed = 25; // m/s cap for petal scaling

        var normalizedSpeed = Math.Clamp(speed / referenceSpeed, 0, 1);
        var radius = minRadius + (normalizedSpeed * (maxRadius - minRadius));
        var shoulderOffset = 9 + (normalizedSpeed * 6);
        var shoulderY = center - radius + 14;
        var tipY = center - radius;

        return string.Create(
            provider: System.Globalization.CultureInfo.InvariantCulture,
            $"{center:0.0},{center:0.0} {center - shoulderOffset:0.0},{shoulderY:0.0} {center:0.0},{tipY:0.0} {center + shoulderOffset:0.0},{shoulderY:0.0}");
    }
}
