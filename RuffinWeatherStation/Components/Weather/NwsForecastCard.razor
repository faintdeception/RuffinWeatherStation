@using RuffinWeatherStation.Models
@inject IConfiguration Configuration

<div class="card nws-forecast-card mt-3">
    <div class="card-header text-white nws-forecast-header d-flex justify-content-between align-items-start gap-2 flex-wrap">
        <div>
            <h3 class="mb-0">@Title</h3>
            <small class="opacity-75">@Subtitle</small>
        </div>
        @if (Forecast?.SnapshotFetchedAtUtc != null)
        {
            <div class="d-flex gap-1 flex-wrap">
                <span class="badge @GetFreshnessBadgeClass(Forecast.SnapshotFetchedAtUtc)">@GetFreshnessLabel(Forecast.SnapshotFetchedAtUtc)</span>
                <span class="badge @GetConfidenceBadgeClass(periodsForDisplay)">Confidence: @GetConfidenceLabel(periodsForDisplay)</span>
            </div>
        }
    </div>

    <div class="card-body">
        @if (Forecast == null || !Forecast.HasData || !Forecast.Periods.Any())
        {
            <p class="text-muted mb-0">No NWS forecast periods are available right now.</p>
        }
        else
        {
            @if (GroupByLocalDay)
            {
                var amItems = BuildDayPartRowItems(periodsForDisplay, isDaytime: true, "AM");
                var pmItems = BuildDayPartRowItems(periodsForDisplay, isDaytime: false, "PM");

                <div class="nws-forecast-matrix" aria-label="Forecast by day and daypart">
                    @if (amItems.Any(i => i.Period != null))
                    {
                        <section class="nws-forecast-row-block" aria-label="AM forecast">
                            <div class="nws-forecast-row-title">AM</div>
                            <div class="nws-forecast-row-grid" style="--forecast-day-columns:@amItems.Count;">
                                @foreach (var item in amItems)
                                {
                                    if (item.Period != null)
                                    {
                                        @RenderPeriodCard(item.Period, true, item.DayLabel, item.DayPartName, compactContent: true)
                                    }
                                    else
                                    {
                                        @RenderEmptyPeriodCard(item.DayLabel, item.DayPartName)
                                    }
                                }
                            </div>
                        </section>
                    }

                    @if (pmItems.Any(i => i.Period != null))
                    {
                        <section class="nws-forecast-row-block" aria-label="PM forecast">
                            <div class="nws-forecast-row-title">PM</div>
                            <div class="nws-forecast-row-grid" style="--forecast-day-columns:@pmItems.Count;">
                                @foreach (var item in pmItems)
                                {
                                    if (item.Period != null)
                                    {
                                        @RenderPeriodCard(item.Period, true, item.DayLabel, item.DayPartName, compactContent: true)
                                    }
                                    else
                                    {
                                        @RenderEmptyPeriodCard(item.DayLabel, item.DayPartName)
                                    }
                                }
                            </div>
                        </section>
                    }
                </div>
            }
            else
            {
                <div class="nws-forecast-strip" aria-label="Forecast periods">
                    @foreach (var period in periodsForDisplay)
                    {
                        @RenderPeriodCard(period)
                    }
                </div>
            }

            @if (ShowGardenActions)
            {
                var legendItems = GetGardenLegendItems(periodsForDisplay);
                if (legendItems.Any())
                {
                    <div class="nws-forecast-actions-legend mt-2" aria-label="Garden alert legend">
                        @foreach (var item in legendItems)
                        {
                            <span class="nws-forecast-actions-legend-item" title="@item.Label">
                                <span class="nws-forecast-action-marker" aria-hidden="true">
                                    @if (HasGardenActionEmoji(item))
                                    {
                                        <span class="nws-forecast-action-emoji" aria-hidden="true">@item.Emoji</span>
                                    }
                                    else
                                    {
                                        <span class="nws-forecast-action-dot @item.CssClass" aria-hidden="true"></span>
                                    }
                                </span>
                                <span>@item.Label</span>
                            </span>
                        }
                    </div>
                }
            }

            @if (ShowSnapshotMeta)
            {
                <div class="nws-forecast-meta mt-2">
                    <small class="text-muted">
                        Snapshot: @FormatPeriodStart(Forecast.SnapshotFetchedAtUtc) (@FormatSnapshotAge(Forecast.SnapshotFetchedAtUtc)) · Location: @Forecast.Location
                    </small>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public NwsForecastData? Forecast { get; set; }

    [Parameter]
    public string Title { get; set; } = "NWS Forecast";

    [Parameter]
    public string Subtitle { get; set; } = "National Weather Service outlook";

    [Parameter]
    public int MaxItems { get; set; } = 14;

    [Parameter]
    public bool ShowDetailed { get; set; }

    [Parameter]
    public bool ShowSnapshotMeta { get; set; } = true;

    [Parameter]
    public bool ShowGardenActions { get; set; }

    [Parameter]
    public bool GroupByLocalDay { get; set; }

    private List<NwsForecastPeriodData> periodsForDisplay = new();

    protected override void OnParametersSet()
    {
        periodsForDisplay = Forecast?.Periods?
            .OrderBy(p => p.StartTimeUtc ?? DateTime.MaxValue)
            .Take(Math.Max(1, MaxItems))
            .ToList() ?? new List<NwsForecastPeriodData>();
    }

    private RenderFragment RenderPeriodCard(
        NwsForecastPeriodData period,
        bool showDayChip = false,
        string? dayLabelOverride = null,
        string? nameOverride = null,
        bool compactContent = false) => @<article class="nws-forecast-period @(period.IsDaytime ? "is-day" : "is-night") @(ShowFlipPreview(period, compactContent) ? "has-preview" : string.Empty)"
                                                 tabindex="@(ShowFlipPreview(period, compactContent) ? "0" : null)"
                                                 title="@(ShowFlipPreview(period, compactContent) ? "Hover or tap to preview icon detail" : null)">
        @if (ShowFlipPreview(period, compactContent))
        {
            <div class="nws-forecast-card-flip">
                <div class="nws-forecast-period-content nws-forecast-face nws-forecast-face-front">
                    <span class="nws-forecast-flip-hint" aria-hidden="true">View icon</span>
                    @RenderPeriodContent(period, showDayChip, dayLabelOverride, nameOverride, compactContent)
                </div>

                <div class="nws-forecast-face nws-forecast-face-back" aria-hidden="true">
                    <img src="@ResolveIconUrl(period.IconUrl)"
                         alt="@GetForecastIconAltText(period)"
                         loading="lazy" />
                    <div class="nws-forecast-face-back-caption">@GetForecastIconAltText(period)</div>
                </div>
            </div>
        }
        else
        {
            <div class="nws-forecast-period-content">
                @RenderPeriodContent(period, showDayChip, dayLabelOverride, nameOverride, compactContent)
            </div>
        }
    </article>;

    private static RenderFragment RenderEmptyPeriodCard(string dayLabel, string dayPartName) => @<article class="nws-forecast-period nws-forecast-period-empty" aria-label="No @dayPartName forecast for @dayLabel">
        <div class="nws-forecast-period-content">
            <header class="nws-forecast-period-header">
                <div class="nws-forecast-period-title-stack">
                    <div class="nws-forecast-day-chip">@dayLabel</div>
                    <div class="nws-forecast-period-name">@dayPartName</div>
                </div>
            </header>
            <p class="nws-forecast-detail mb-0">No period available</p>
        </div>
    </article>;

    private RenderFragment RenderPeriodContent(
        NwsForecastPeriodData period,
        bool showDayChip,
        string? dayLabelOverride,
        string? nameOverride,
        bool compactContent) => @<text>
        <header class="nws-forecast-period-header">
            <div class="nws-forecast-period-title-wrap">
                <span class="nws-forecast-icon @GetForecastIconToneClass(period)" aria-hidden="true">@GetForecastIconGlyph(period)</span>
                <div class="nws-forecast-period-title-stack">
                    @if (showDayChip)
                    {
                        <div class="nws-forecast-day-chip">@(dayLabelOverride ?? GetPeriodDayLabel(period))</div>
                    }
                    <div class="nws-forecast-period-name">@(nameOverride ?? period.Name)</div>
                </div>
            </div>
            @if (!compactContent)
            {
                <div class="nws-forecast-period-time">@FormatPeriodStart(period.StartTimeUtc)</div>
            }
        </header>

        <div class="nws-forecast-keyline">
            <span class="nws-forecast-temp">@FormatTemperature(period)</span>
            <span class="nws-forecast-pop"
                  aria-label="@GetPrecipitationLabel(period.PrecipitationChancePercent)"
                  title="@GetPrecipitationLabel(period.PrecipitationChancePercent)">
                @GetPrecipitationEmoji(period.PrecipitationChancePercent) @FormatPercent(period.PrecipitationChancePercent)
            </span>
        </div>

        @if (!compactContent)
        {
            <div class="nws-forecast-keyline subtle">
                <span>Wind @FormatWind(period)</span>
                @if (!string.IsNullOrWhiteSpace(period.WindDirection))
                {
                    <span>@period.WindDirection</span>
                }
            </div>
        }

        @if (ShowGardenActions)
        {
            var actionTags = GetGardenActions(period);
            if (actionTags.Any())
            {
                <div class="nws-forecast-actions-dotline mt-2" role="list" aria-label="Garden planning alerts">
                    @foreach (var action in actionTags)
                    {
                        <span class="nws-forecast-action-marker"
                              role="listitem"
                              title="@action.Label"
                              aria-label="@action.Label">
                            @if (HasGardenActionEmoji(action))
                            {
                                <span class="nws-forecast-action-emoji" aria-hidden="true">@action.Emoji</span>
                            }
                            else
                            {
                                <span class="nws-forecast-action-dot @action.CssClass" aria-hidden="true"></span>
                            }
                        </span>
                    }
                </div>
            }
        }

        @if (ShowDetailed && !compactContent && !string.IsNullOrWhiteSpace(period.DetailedForecast))
        {
            <p class="nws-forecast-detail mb-0">@period.DetailedForecast</p>
        }
        else if (!string.IsNullOrWhiteSpace(period.ShortForecast))
        {
            <p class="nws-forecast-detail mb-0">@period.ShortForecast</p>
        }
    </text>;

    private static string FormatTemperature(NwsForecastPeriodData period)
    {
        if (period.CelsiusTemperature.HasValue)
        {
            var c = Math.Round(period.CelsiusTemperature.Value);
            var f = Math.Round(GetFahrenheitTemperature(period));
            return $"{c}°C ({f}°F)";
        }

        if (!period.Temperature.HasValue)
        {
            return "--";
        }

        return $"{Math.Round(period.Temperature.Value)}°{period.TemperatureUnit}";
    }

    private static string FormatPercent(double? value)
    {
        if (!value.HasValue)
        {
            return "--";
        }

        return $"{Math.Round(value.Value)}%";
    }

    private static string GetPrecipitationEmoji(double? value)
    {
        if (!value.HasValue)
        {
            return "🌦️";
        }

        if (value.Value < 15)
        {
            return "🌤️";
        }

        if (value.Value < 35)
        {
            return "⛅";
        }

        if (value.Value < 60)
        {
            return "🌦️";
        }

        if (value.Value < 80)
        {
            return "🌧️";
        }

        return "⛈️";
    }

    private static string GetPrecipitationLabel(double? value)
    {
        if (!value.HasValue)
        {
            return "Precipitation chance unavailable";
        }

        return $"Precipitation chance {Math.Round(value.Value)} percent";
    }

    private static string FormatWind(NwsForecastPeriodData period)
    {
        if (!string.IsNullOrWhiteSpace(period.WindSpeedText))
        {
            return period.WindSpeedText;
        }

        if (period.WindSpeedMphMax.HasValue)
        {
            return $"up to {Math.Round(period.WindSpeedMphMax.Value)} mph";
        }

        return "--";
    }

    private static string FormatPeriodStart(DateTime? utc)
    {
        if (!utc.HasValue)
        {
            return "Unknown";
        }

        return utc.Value.ToLocalTime().ToString("ddd h:mm tt");
    }

    private static string FormatDayHeading(DateTime localDate)
    {
        var today = DateTime.Now.Date;
        if (localDate == today)
        {
            return "Today";
        }

        if (localDate == today.AddDays(1))
        {
            return "Tomorrow";
        }

        return localDate.ToString("dddd, MMM d");
    }

    private static string GetPeriodDayLabel(NwsForecastPeriodData period)
    {
        var localDate = (period.StartTimeUtc ?? DateTime.UtcNow).ToLocalTime().Date;
        return FormatDayHeading(localDate);
    }

    private static string FormatCompactDayLabel(DateTime localDate)
    {
        var today = DateTime.Now.Date;
        if (localDate == today)
        {
            return "Today";
        }

        if (localDate == today.AddDays(1))
        {
            return "Tomorrow";
        }

        return localDate.ToString("ddd, MMM d");
    }

    private static List<ForecastRowItem> BuildDayPartRowItems(
        IReadOnlyList<NwsForecastPeriodData> periods,
        bool isDaytime,
        string dayPartName)
    {
        return periods
            .GroupBy(p => (p.StartTimeUtc ?? DateTime.UtcNow).ToLocalTime().Date)
            .OrderBy(g => g.Key)
            .Select(g => new ForecastRowItem
            {
                DayLabel = FormatCompactDayLabel(g.Key),
                DayPartName = dayPartName,
                Period = g.FirstOrDefault(p => p.IsDaytime == isDaytime)
            })
            .ToList();
    }

    private static bool ShowFlipPreview(NwsForecastPeriodData period, bool compactContent)
    {
        return compactContent && !string.IsNullOrWhiteSpace(period.IconUrl);
    }

    private sealed class ForecastRowItem
    {
        public string DayLabel { get; set; } = string.Empty;

        public string DayPartName { get; set; } = string.Empty;

        public NwsForecastPeriodData? Period { get; set; }
    }

    private static string FormatSnapshotAge(DateTime? snapshotUtc)
    {
        if (!snapshotUtc.HasValue)
        {
            return "age unknown";
        }

        var age = DateTime.UtcNow - snapshotUtc.Value;
        if (age.TotalHours < 1)
        {
            return $"{Math.Max(1, Math.Round(age.TotalMinutes))}m ago";
        }

        return $"{Math.Round(age.TotalHours, 1)}h ago";
    }

    private static string GetFreshnessBadgeClass(DateTime? snapshotUtc)
    {
        if (!snapshotUtc.HasValue)
        {
            return "text-bg-secondary";
        }

        var age = DateTime.UtcNow - snapshotUtc.Value;
        if (age.TotalHours <= 3)
        {
            return "text-bg-success";
        }

        if (age.TotalHours <= 8)
        {
            return "text-bg-warning";
        }

        return "text-bg-danger";
    }

    private static string GetFreshnessLabel(DateTime? snapshotUtc)
    {
        if (!snapshotUtc.HasValue)
        {
            return "Snapshot age unknown";
        }

        var age = DateTime.UtcNow - snapshotUtc.Value;
        if (age.TotalHours <= 3)
        {
            return "Fresh Snapshot";
        }

        if (age.TotalHours <= 8)
        {
            return "Aging Snapshot";
        }

        return "Stale Snapshot";
    }

    private static string GetConfidenceBadgeClass(IReadOnlyList<NwsForecastPeriodData> periods)
    {
        var score = GetForecastConfidenceScore(periods);
        if (score >= 0.75)
        {
            return "text-bg-success";
        }

        if (score >= 0.5)
        {
            return "text-bg-warning";
        }

        return "text-bg-danger";
    }

    private static string GetConfidenceLabel(IReadOnlyList<NwsForecastPeriodData> periods)
    {
        var score = GetForecastConfidenceScore(periods);
        if (score >= 0.75)
        {
            return "High";
        }

        if (score >= 0.5)
        {
            return "Medium";
        }

        return "Low";
    }

    private static double GetForecastConfidenceScore(IReadOnlyList<NwsForecastPeriodData> periods)
    {
        if (periods.Count == 0)
        {
            return 0;
        }

        var scored = periods.Select(p =>
        {
            var checks = 0;
            var total = 5;

            if (p.StartTimeUtc.HasValue) checks++;
            if (p.Temperature.HasValue) checks++;
            if (p.PrecipitationChancePercent.HasValue) checks++;
            if (!string.IsNullOrWhiteSpace(p.WindSpeedText) || p.WindSpeedMphMax.HasValue) checks++;
            if (!string.IsNullOrWhiteSpace(p.ShortForecast) || !string.IsNullOrWhiteSpace(p.DetailedForecast)) checks++;

            return (double)checks / total;
        });

        return scored.Average();
    }

    private static IReadOnlyList<GardenActionTag> GetGardenActions(NwsForecastPeriodData period)
    {
        var actions = new List<GardenActionTag>();
        var text = $"{period.ShortForecast} {period.DetailedForecast}".ToLowerInvariant();
        var rainChance = period.PrecipitationChancePercent ?? 0;
        var windMax = period.WindSpeedMphMax ?? 0;
        var tempF = GetTempF(period);

        if ((!period.IsDaytime || tempF <= 36) && (text.Contains("frost") || text.Contains("freeze") || tempF <= 33))
        {
            actions.Add(new GardenActionTag("Frost caution", "action-frost", "❄️"));
        }

        if (rainChance >= 45 || text.Contains("rain") || text.Contains("showers") || text.Contains("thunder"))
        {
            actions.Add(new GardenActionTag("Delay watering", "action-delay", "💧"));
        }

        if (windMax >= 18 || text.Contains("gust") || text.Contains("thunder"))
        {
            actions.Add(new GardenActionTag("Skip foliar spray", "action-spray", "💨"));
        }

        if (period.IsDaytime && rainChance < 30 && windMax > 0 && windMax <= 12)
        {
            actions.Add(new GardenActionTag("Good mowing window", "action-mow", "🚜"));
        }

        if (period.IsDaytime && tempF >= 50 && tempF <= 86 && rainChance < 40 && windMax <= 15)
        {
            actions.Add(new GardenActionTag("Good planting window", "action-plant", "🌱"));
        }

        if (actions.Count == 0)
        {
            actions.Add(new GardenActionTag("Monitor conditions", "action-monitor"));
        }

        return actions
            .DistinctBy(a => a.Label)
            .Take(3)
            .ToList();
    }

    private static IReadOnlyList<GardenActionTag> GetGardenLegendItems(IReadOnlyList<NwsForecastPeriodData> periods)
    {
        if (periods.Count == 0)
        {
            return Array.Empty<GardenActionTag>();
        }

        var sortOrder = new Dictionary<string, int>(StringComparer.Ordinal)
        {
            ["Frost caution"] = 0,
            ["Delay watering"] = 1,
            ["Skip foliar spray"] = 2,
            ["Good planting window"] = 3,
            ["Good mowing window"] = 4,
            ["Monitor conditions"] = 5
        };

        return periods
            .SelectMany(GetGardenActions)
            .DistinctBy(a => a.Label)
            .OrderBy(a => sortOrder.GetValueOrDefault(a.Label, int.MaxValue))
            .ToList();
    }

    private static bool HasGardenActionEmoji(GardenActionTag action)
    {
        return !string.IsNullOrWhiteSpace(action.Emoji);
    }

    private static string GetForecastIconGlyph(NwsForecastPeriodData period)
    {
        var sourceText = string.IsNullOrWhiteSpace(period.ShortForecast)
            ? period.DetailedForecast
            : period.ShortForecast;
        var text = sourceText.ToLowerInvariant();

        if (text.Contains("thunder") || text.Contains("t-storm") || text.Contains("lightning"))
        {
            return "⛈";
        }

        if (text.Contains("snow") || text.Contains("flurr"))
        {
            return "🌨";
        }

        if (text.Contains("rain") || text.Contains("showers") || text.Contains("drizzle"))
        {
            return "🌧";
        }

        if (text.Contains("fog") || text.Contains("mist") || text.Contains("haze"))
        {
            return "🌫";
        }

        if (text.Contains("wind"))
        {
            return "🌬";
        }

        if (text.Contains("mostly cloudy") || text.Contains("overcast") || text.Contains("cloudy"))
        {
            return "☁";
        }

        if (text.Contains("partly cloudy") || text.Contains("mostly sunny") || text.Contains("partly sunny"))
        {
            return period.IsDaytime ? "⛅" : "☁";
        }

        if (text.Contains("clear") || text.Contains("sunny"))
        {
            return period.IsDaytime ? "☀" : "🌙";
        }

        return period.IsDaytime ? "⛅" : "🌙";
    }

    private static string GetForecastIconToneClass(NwsForecastPeriodData period)
    {
        var sourceText = string.IsNullOrWhiteSpace(period.ShortForecast)
            ? period.DetailedForecast
            : period.ShortForecast;
        var text = sourceText.ToLowerInvariant();

        if (text.Contains("thunder") || text.Contains("rain") || text.Contains("showers") || text.Contains("drizzle") || text.Contains("snow"))
        {
            return "tone-wet";
        }

        if (text.Contains("fog") || text.Contains("haze") || text.Contains("cloud"))
        {
            return "tone-cloud";
        }

        if (period.IsDaytime)
        {
            return "tone-sun";
        }

        return "tone-night";
    }

    private static string GetForecastIconAltText(NwsForecastPeriodData period)
    {
        if (!string.IsNullOrWhiteSpace(period.ShortForecast))
        {
            return $"{period.Name}: {period.ShortForecast}";
        }

        return $"{period.Name} forecast icon";
    }

    private string ResolveIconUrl(string iconUrl)
    {
        if (string.IsNullOrWhiteSpace(iconUrl))
        {
            return string.Empty;
        }

        if (Uri.TryCreate(iconUrl, UriKind.Absolute, out _))
        {
            return iconUrl;
        }

        if (!iconUrl.StartsWith('/'))
        {
            return iconUrl;
        }

        var apiBaseUrl = Configuration["ApiSettings:BaseUrl"];
        if (string.IsNullOrWhiteSpace(apiBaseUrl))
        {
            return iconUrl;
        }

        return $"{apiBaseUrl.TrimEnd('/')}{iconUrl}";
    }

    private static double GetTempF(NwsForecastPeriodData period)
    {
        if (period.CelsiusTemperature.HasValue)
        {
            return (period.CelsiusTemperature.Value * 9 / 5) + 32;
        }

        if (!period.Temperature.HasValue)
        {
            return double.NaN;
        }

        if (string.Equals(period.TemperatureUnit, "C", StringComparison.OrdinalIgnoreCase))
        {
            return (period.Temperature.Value * 9 / 5) + 32;
        }

        return period.Temperature.Value;
    }

    private static double GetFahrenheitTemperature(NwsForecastPeriodData period)
    {
        if (period.Temperature.HasValue && string.Equals(period.TemperatureUnit, "F", StringComparison.OrdinalIgnoreCase))
        {
            return period.Temperature.Value;
        }

        if (period.CelsiusTemperature.HasValue)
        {
            return (period.CelsiusTemperature.Value * 9 / 5) + 32;
        }

        if (period.Temperature.HasValue && string.Equals(period.TemperatureUnit, "C", StringComparison.OrdinalIgnoreCase))
        {
            return (period.Temperature.Value * 9 / 5) + 32;
        }

        return period.Temperature ?? double.NaN;
    }

    private sealed record GardenActionTag(string Label, string CssClass, string? Emoji = null);
}
