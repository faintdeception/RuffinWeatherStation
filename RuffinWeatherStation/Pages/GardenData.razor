@page "/garden-data"
@inject TemperatureService TemperatureService
@inject GardenDataService GardenDataService
@inject GardenPlantProfileService GardenPlantProfileService

<h1>Garden Data</h1>

<p class="text-muted">
    Garden-focused weather context, seasonal reference dates, and frost timing guidance for planning.
</p>

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Loading garden data...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-warning" role="alert">@errorMessage</div>
}
else
{
    <div class="row gy-3">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">Recent Rainfall (Last @recentRainfallDays Days)</h3>
                </div>
                <div class="card-body">
                    @if (rainfallAnalysis?.DailyRainfall != null && rainfallAnalysis.DailyRainfall.Any())
                    {
                        <div class="mb-3">
                            <div><strong>Total:</strong> @rainfallAnalysis.TotalRainfall.ToString("F1") mm</div>
                            <div><strong>Rainy Days:</strong> @rainfallAnalysis.RainyDaysCount / @recentRainfallDays</div>
                            <div><strong>Longest Dry Spell:</strong> @rainfallAnalysis.LongestDrySpellDays day(s)</div>
                        </div>

                        <RadzenChart class="garden-rain-chart">
                            <RadzenColumnSeries Data="@rainfallAnalysis.DailyRainfall"
                                                CategoryProperty="Timestamp"
                                                ValueProperty="Total"
                                                Title="Daily Rain (mm)"
                                                Fill="rgba(46, 139, 87, 0.75)" />
                            <RadzenCategoryAxis Formatter="@FormatDateLabel" />
                            <RadzenValueAxis>
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="Rainfall (mm)" />
                            </RadzenValueAxis>
                            <RadzenLegend Position="LegendPosition.Top" />
                        </RadzenChart>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No rainfall history is available for the selected period.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Season And Frost Reference</h3>
                </div>
                <div class="card-body">
                    @if (gardenReference != null)
                    {
                        <p class="mb-2"><strong>Location:</strong> @gardenReference.LocationLabel</p>
                        <p class="mb-3"><strong>Average Last Frost:</strong> @FormatDate(gardenReference.AverageLastFrostDate)</p>

                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Season</th>
                                    <th>Start Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>Spring</td><td>@FormatDate(gardenReference.SeasonStarts.Spring)</td></tr>
                                <tr><td>Summer</td><td>@FormatDate(gardenReference.SeasonStarts.Summer)</td></tr>
                                <tr><td>Fall</td><td>@FormatDate(gardenReference.SeasonStarts.Fall)</td></tr>
                                <tr><td>Winter</td><td>@FormatDate(gardenReference.SeasonStarts.Winter)</td></tr>
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Garden reference dates are unavailable right now.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h3 class="mb-0">Planning Windows</h3>
                </div>
                <div class="card-body">
                    @if (gardenReference != null)
                    {
                        <div class="row gy-2">
                            <div class="col-md-4">
                                <div class="p-3 border rounded h-100">
                                    <h5 class="mb-2">Seed Starting Window</h5>
                                    <p class="mb-1">
                                        @FormatDate(seedWindowStart) to @FormatDate(seedWindowEnd)
                                    </p>
                                    <small class="text-muted">Based on average last frost date.</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border rounded h-100">
                                    <h5 class="mb-2">Hose And Equipment Check</h5>
                                    <p class="mb-1">
                                        @FormatDate(hoseWindowStart) to @FormatDate(hoseWindowEnd)
                                    </p>
                                    <small class="text-muted">Centered around first day of spring.</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border rounded h-100">
                                    <h5 class="mb-2">Recent Temperature Pattern</h5>
                                    <p class="mb-1">
                                        Trend: @temperatureTrendSummary
                                    </p>
                                    <p class="mb-1">Frost Days (10 days): @recentFrostDays</p>
                                    <small class="text-muted">Computed from recent daily station aggregates.</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info-subtle d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">Season Transition Signal</h3>
                    <span class="badge @GetSeasonRegimeBadgeClass(seasonRegimeLabel)">@seasonRegimeLabel</span>
                </div>
                <div class="card-body">
                    @if (seasonTrendData.Count == 0)
                    {
                        <p class="text-muted mb-0">Not enough recent daily data to evaluate seasonal transition patterns.</p>
                    }
                    else
                    {
                        <div class="row gy-2 mb-3">
                            <div class="col-md-4 col-12">
                                <strong>Confidence:</strong> @seasonRegimeConfidence%
                            </div>
                            <div class="col-md-8 col-12">
                                <strong>Why:</strong> @seasonRegimeWhy
                            </div>
                        </div>

                        <RadzenChart class="season-trend-chart">
                            <RadzenLineSeries Data="@seasonTrendData"
                                              CategoryProperty="Date"
                                              ValueProperty="HighF"
                                              Title="Daily High (F)"
                                              LineType="LineType.Solid"
                                              StrokeWidth="3" />
                            <RadzenLineSeries Data="@seasonTrendData"
                                              CategoryProperty="Date"
                                              ValueProperty="LowF"
                                              Title="Daily Low (F)"
                                              LineType="LineType.Dashed"
                                              StrokeWidth="2" />
                            <RadzenCategoryAxis Formatter="@FormatSeasonDateLabel" />
                            <RadzenValueAxis>
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="Temperature (F)" />
                            </RadzenValueAxis>
                            <RadzenLegend Position="LegendPosition.Top" />
                        </RadzenChart>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header bg-warning-subtle">
                    <h3 class="mb-0">Plant Readiness (JSON Rules)</h3>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="showDormantCardsToggle" @bind="showDormantCards" />
                        <label class="form-check-label" for="showDormantCardsToggle">Show dormant cards (debug)</label>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(plantProfilesLoadError))
                    {
                        <div class="alert alert-warning mb-0">@plantProfilesLoadError</div>
                    }
                    else if (plantReadinessCards.Count == 0)
                    {
                        <p class="text-muted mb-0">No plant profile entries found. Add entries to `wwwroot/data/garden-plants.json`.</p>
                    }
                    else
                    {
                        @if (!GetVisiblePlantReadinessCards().Any())
                        {
                            <div class="alert alert-secondary mb-0">
                                No actionable cards right now. Turn on `Show dormant cards` to inspect inactive entries.
                            </div>
                        }
                        else
                        {
                            @if (GetActionNowCards().Any())
                            {
                                <h5 class="mb-3">Do This Now</h5>
                                <div class="row gy-3 mb-4">
                                    @foreach (var card in GetActionNowCards())
                                    {
                                        <div class="col-lg-4 col-md-6">
                                            <div class="p-3 border rounded h-100">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <div>
                                                        <h5 class="mb-0">@card.DisplayName</h5>
                                                        <small class="text-muted">@card.CategoriesLabel · @card.ActionTypeLabel</small>
                                                    </div>
                                                    <span class="badge @card.BadgeClass">@card.StatusLabel</span>
                                                </div>

                                                <div class="small mb-2">
                                                    <div><strong>Target transplant date:</strong> @FormatNullableDate(card.TargetTransplantDate)</div>
                                                    <div><strong>Indoor start target:</strong> @FormatNullableDate(card.IndoorStartDate)</div>
                                                    <div><strong>Night streak:</strong> @card.CurrentNightStreak / @card.RequiredConsecutiveNights nights @card.StreakOperatorLabel @card.NightTempThresholdF.ToString("F0")F</div>
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(card.RuleExplanation))
                                                {
                                                    <div class="small text-muted mb-1"><strong>Rule:</strong> @card.RuleExplanation</div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(card.TimingExplanation))
                                                {
                                                    <div class="small text-muted mb-2"><strong>Timing:</strong> @card.TimingExplanation</div>
                                                }

                                                <p class="mb-1">@card.Guidance</p>
                                                @if (!string.IsNullOrWhiteSpace(card.Notes))
                                                {
                                                    <small class="text-muted">@card.Notes</small>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @if (GetSoonCards().Any())
                            {
                                <h5 class="mb-3">Prepare Soon</h5>
                                <div class="row gy-3">
                                    @foreach (var card in GetSoonCards())
                                    {
                                        <div class="col-lg-4 col-md-6">
                                            <div class="p-3 border rounded h-100">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <div>
                                                        <h5 class="mb-0">@card.DisplayName</h5>
                                                        <small class="text-muted">@card.CategoriesLabel · @card.ActionTypeLabel</small>
                                                    </div>
                                                    <span class="badge @card.BadgeClass">@card.StatusLabel</span>
                                                </div>

                                                <div class="small mb-2">
                                                    <div><strong>Target transplant date:</strong> @FormatNullableDate(card.TargetTransplantDate)</div>
                                                    <div><strong>Indoor start target:</strong> @FormatNullableDate(card.IndoorStartDate)</div>
                                                    <div><strong>Night streak:</strong> @card.CurrentNightStreak / @card.RequiredConsecutiveNights nights @card.StreakOperatorLabel @card.NightTempThresholdF.ToString("F0")F</div>
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(card.RuleExplanation))
                                                {
                                                    <div class="small text-muted mb-1"><strong>Rule:</strong> @card.RuleExplanation</div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(card.TimingExplanation))
                                                {
                                                    <div class="small text-muted mb-2"><strong>Timing:</strong> @card.TimingExplanation</div>
                                                }

                                                <p class="mb-1">@card.Guidance</p>
                                                @if (!string.IsNullOrWhiteSpace(card.Notes))
                                                {
                                                    <small class="text-muted">@card.Notes</small>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header bg-danger-subtle">
                    <h3 class="mb-0">Weather Risk Snapshot (NWS)</h3>
                </div>
                <div class="card-body">
                    @if (nwsAlertSummary == null)
                    {
                        <p class="text-muted mb-0">No NWS snapshot summary is currently available.</p>
                    }
                    else
                    {
                        <div class="row gy-2 mb-3">
                            <div class="col-md-3 col-6"><strong>Total Snapshots:</strong> @nwsAlertSummary.TotalSnapshots</div>
                            <div class="col-md-3 col-6"><strong>Active:</strong> @nwsAlertSummary.ActiveAlerts</div>
                            <div class="col-md-3 col-6"><strong>Expired:</strong> @nwsAlertSummary.ExpiredAlerts</div>
                            <div class="col-md-3 col-6"><strong>Severe/Extreme:</strong> @nwsAlertSummary.SevereOrExtremeAlerts</div>
                        </div>

                        <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
                            <div><strong>Snapshot Fetched:</strong> @FormatUtcDateTime(nwsAlertSummary.SnapshotFetchedAtUtc)</div>
                            <div>
                                <strong>Snapshot Status:</strong>
                                <span class="badge @(nwsAlertSummary.IsSnapshotExpired ? "text-bg-secondary" : "text-bg-success") ms-1">
                                    @(nwsAlertSummary.IsSnapshotExpired ? "Expired" : "Active")
                                </span>
                            </div>
                        </div>

                        @if (nwsAlertSummary.ActiveAlerts > 0 || nwsAlertSummary.SevereOrExtremeAlerts > 0)
                        {
                            <div class="alert alert-danger">
                                Elevated weather risk detected in the last @nwsAlertSummary.LookbackDays day(s). Consider securing loose equipment, checking drainage, and preparing protective covers.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success">
                                No high-risk NWS patterns detected in the selected lookback period.
                            </div>
                        }

                        @if (nwsAlertSummary.RecentAlerts.Any())
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var alert in nwsAlertSummary.RecentAlerts)
                                {
                                    <div class="border rounded p-3">
                                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                            <div>
                                                <h6 class="mb-1">@alert.Event</h6>
                                                <div class="text-muted">@alert.Headline</div>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <span class="badge text-bg-primary">@alert.Severity</span>
                                                <span class="badge @(alert.IsActive ? "text-bg-success" : "text-bg-secondary")">@(alert.IsActive ? "Active" : "Expired")</span>
                                            </div>
                                        </div>

                                        <div class="row gy-2 mb-2">
                                            <div class="col-md-3 col-6"><strong>Urgency:</strong> @alert.Urgency</div>
                                            <div class="col-md-3 col-6"><strong>Certainty:</strong> @alert.Certainty</div>
                                            <div class="col-md-3 col-6"><strong>Onset:</strong> @FormatUtcDateTime(alert.OnsetUtc)</div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(alert.Instruction))
                                        {
                                            <div class="alert alert-warning py-2 mb-2">
                                                <strong>Instruction:</strong> @alert.Instruction
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(alert.Description))
                                        {
                                            <details>
                                                <summary>Description</summary>
                                                <div class="mt-2" style="white-space: pre-wrap;">@alert.Description</div>
                                            </details>
                                        }

                                        <div class="mt-2 small text-muted">
                                            @if (!string.IsNullOrWhiteSpace(alert.SourceUrl))
                                            {
                                                <a href="@alert.SourceUrl" target="_blank" rel="noopener noreferrer">Open source alert</a>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(alert.AlertId))
                                            {
                                                <span>Alert ID: @alert.AlertId</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (nwsAlertSummary.MitigationRecommendations.Any())
                        {
                            <hr />
                            <h5 class="mb-3">Mitigation Playbook</h5>
                            <div class="row gy-2">
                                @foreach (var recommendation in nwsAlertSummary.MitigationRecommendations)
                                {
                                    <div class="col-md-6">
                                        <div class="border rounded p-3 h-100">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <strong>@recommendation.Category</strong>
                                                <span class="badge @GetPriorityBadgeClass(recommendation.Priority)">@recommendation.Priority</span>
                                            </div>
                                            <p class="mb-0">@recommendation.Guidance</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

    </div>
}

<style>
    .garden-rain-chart {
        height: 260px;
    }

    .season-trend-chart {
        height: 260px;
    }

    @@media (max-width: 768px) {
        .garden-rain-chart {
            height: 220px;
        }

        .season-trend-chart {
            height: 220px;
        }
    }
</style>

@code {
    private const int recentRainfallDays = 15;
    private const int recentTemperaturePatternDays = 10;
    private const int seasonVisualizationDays = 21;
    private const int dailyMeasurementLookbackDays = 21;

    private bool isLoading = true;
    private string? errorMessage;

    private GardenReferenceData? gardenReference;
    private NwsAlertSummaryData? nwsAlertSummary;
    private WeatherAnalysisResult? rainfallAnalysis;
    private List<DailyMeasurement>? recentDailyMeasurements;
    private List<GardenPlantProfile> plantProfiles = new();
    private List<PlantReadinessCard> plantReadinessCards = new();
    private string? plantProfilesLoadError;

    private DateOnly seedWindowStart;
    private DateOnly seedWindowEnd;
    private DateOnly hoseWindowStart;
    private DateOnly hoseWindowEnd;
    private int recentFrostDays;
    private string temperatureTrendSummary = "Unknown";
    private bool showDormantCards;
    private List<SeasonTrendPoint> seasonTrendData = new();
    private string seasonRegimeLabel = "Unknown";
    private string seasonRegimeWhy = "Not enough data.";
    private int seasonRegimeConfidence;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var rainfallTask = TemperatureService.GetAnalysisAsync(recentRainfallDays, rainOnly: true);
            var dailyTask = TemperatureService.GetDailyMeasurementsAsync(dailyMeasurementLookbackDays);
            var referenceTask = GardenDataService.GetGardenReferenceAsync();
            var plantProfilesTask = GardenPlantProfileService.GetProfilesAsync();
            var alertsTask = GardenDataService.GetAlertsSummaryAsync(days: 7);

            await Task.WhenAll(rainfallTask, dailyTask, referenceTask, plantProfilesTask, alertsTask);

            rainfallAnalysis = rainfallTask.Result;
            recentDailyMeasurements = dailyTask.Result;
            gardenReference = referenceTask.Result;
            plantProfiles = plantProfilesTask.Result.Profiles;
            plantProfilesLoadError = plantProfilesTask.Result.ErrorMessage;
            nwsAlertSummary = alertsTask.Result;

            if (gardenReference == null)
            {
                errorMessage = "Unable to load garden reference data from the API.";
                return;
            }

            CalculatePlanningWindows();
            CalculateTemperaturePattern();
            CalculateSeasonRegime();
            BuildPlantReadinessCards();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load garden data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculatePlanningWindows()
    {
        if (gardenReference == null)
        {
            return;
        }

        seedWindowStart = gardenReference.AverageLastFrostDate.AddDays(-42);
        seedWindowEnd = gardenReference.AverageLastFrostDate.AddDays(-14);

        hoseWindowStart = gardenReference.SeasonStarts.Spring.AddDays(-14);
        hoseWindowEnd = gardenReference.SeasonStarts.Spring.AddDays(14);
    }

    private void CalculateTemperaturePattern()
    {
        if (recentDailyMeasurements == null || recentDailyMeasurements.Count == 0)
        {
            temperatureTrendSummary = "No daily measurements";
            recentFrostDays = 0;
            return;
        }

        var ordered = recentDailyMeasurements
            .OrderBy(d => d.TimestampMs)
            .ToList();

        var recentPatternWindow = ordered
            .TakeLast(recentTemperaturePatternDays)
            .ToList();

        if (recentPatternWindow.Count == 0)
        {
            temperatureTrendSummary = "No daily measurements";
            recentFrostDays = 0;
            return;
        }

        var firstAvg = recentPatternWindow.First().Fields.Temperature.Avg;
        var lastAvg = recentPatternWindow.Last().Fields.Temperature.Avg;
        var trendDelta = lastAvg - firstAvg;

        if (trendDelta > 1.0)
        {
            temperatureTrendSummary = $"Warming ({trendDelta:F1}C)";
        }
        else if (trendDelta < -1.0)
        {
            temperatureTrendSummary = $"Cooling ({Math.Abs(trendDelta):F1}C)";
        }
        else
        {
            temperatureTrendSummary = "Stable";
        }

        recentFrostDays = recentPatternWindow.Count(d => d.Fields.Temperature.Min <= 0);
    }

    private void CalculateSeasonRegime()
    {
        seasonTrendData.Clear();

        if (recentDailyMeasurements == null || recentDailyMeasurements.Count == 0)
        {
            seasonRegimeLabel = "Insufficient Data";
            seasonRegimeWhy = "No recent daily measurements available.";
            seasonRegimeConfidence = 0;
            return;
        }

        seasonTrendData = recentDailyMeasurements
            .OrderBy(d => d.TimestampMs)
            .TakeLast(seasonVisualizationDays)
            .Select(d => new SeasonTrendPoint
            {
                Date = d.TimestampMs,
                HighF = ToFahrenheit(d.Fields.Temperature.Max),
                LowF = ToFahrenheit(d.Fields.Temperature.Min)
            })
            .ToList();

        if (seasonTrendData.Count < 5)
        {
            seasonRegimeLabel = "Insufficient Data";
            seasonRegimeWhy = "Need at least 5 daily points for stable season detection.";
            seasonRegimeConfidence = 20;
            return;
        }

        var window = seasonTrendData.TakeLast(Math.Min(10, seasonTrendData.Count)).ToList();
        var warmHighDays = window.Count(p => p.HighF >= 68);
        var coldNightDays = window.Count(p => p.LowF <= 36);
        var largeSwingDays = window.Count(p => (p.HighF - p.LowF) >= 28);
        var firstAvg = window.First().AverageF;
        var lastAvg = window.Last().AverageF;
        var avgTrend = lastAvg - firstAvg;
        var warmStableDays = window.Count(p => p.HighF >= 72 && p.LowF >= 50);

        if (warmHighDays >= 3 && coldNightDays >= 3)
        {
            seasonRegimeLabel = "False Spring Signal";
            seasonRegimeConfidence = Math.Min(95, 45 + (warmHighDays * 6) + (coldNightDays * 6) + (largeSwingDays * 4));
            seasonRegimeWhy = $"{warmHighDays} warm day(s) >= 68F paired with {coldNightDays} cold night(s) <= 36F in the last {window.Count} days.";
            return;
        }

        if (warmStableDays >= 4 && coldNightDays == 0)
        {
            seasonRegimeLabel = "Warm Stable";
            seasonRegimeConfidence = Math.Min(92, 50 + (warmStableDays * 8));
            seasonRegimeWhy = $"Sustained warmth: {warmStableDays} day(s) with highs >= 72F and lows >= 50F.";
            return;
        }

        if (avgTrend <= -2.5 && coldNightDays >= 2)
        {
            seasonRegimeLabel = "Cooling Pattern";
            seasonRegimeConfidence = Math.Min(90, 45 + (coldNightDays * 7) + (int)Math.Abs(avgTrend * 5));
            seasonRegimeWhy = $"Average temperature trend dropped by {Math.Abs(avgTrend):F1}F with recurring cold nights.";
            return;
        }

        if (avgTrend >= 2.0 && coldNightDays <= 1)
        {
            seasonRegimeLabel = "Spring Stabilizing";
            seasonRegimeConfidence = Math.Min(88, 40 + (int)(avgTrend * 8) + ((window.Count - coldNightDays) * 2));
            seasonRegimeWhy = $"Average temperature trend rose by {avgTrend:F1}F with limited cold-night setbacks.";
            return;
        }

        seasonRegimeLabel = "Transitional";
        seasonRegimeConfidence = 55;
        seasonRegimeWhy = "Mixed daily highs/lows indicate seasonal transition without a dominant regime yet.";
    }

    private void BuildPlantReadinessCards()
    {
        plantReadinessCards.Clear();

        if (gardenReference == null || plantProfiles.Count == 0)
        {
            return;
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        var computedCards = new List<PlantReadinessCard>();

        foreach (var profile in plantProfiles)
        {
            var targetTransplantDate = profile.DaysAfterLastFrostToTransplant.HasValue
                ? gardenReference.AverageLastFrostDate.AddDays(profile.DaysAfterLastFrostToTransplant.Value)
                : (DateOnly?)null;

            var indoorStartDate = profile.DaysBeforeLastFrostToStartIndoors.HasValue
                ? gardenReference.AverageLastFrostDate.AddDays(-profile.DaysBeforeLastFrostToStartIndoors.Value)
                : (DateOnly?)null;

            var nightThresholdF = profile.MinNightTempF ?? 50;
            var useCoolingLogic = profile.Categories?.Any(c =>
                c.Contains("bulb", StringComparison.OrdinalIgnoreCase) ||
                c.Contains("perennial", StringComparison.OrdinalIgnoreCase)) == true;

            var nightStreak = CalculateNightStreak(nightThresholdF, useCoolingLogic);
            var requiredNights = Math.Max(0, profile.RequiredConsecutiveNights);
            var leadDays = Math.Max(0, profile.LeadDays ?? 14);

            var (hasWindow, isInWindow, isWindowSoon, daysUntilWindowStart) = EvaluateMonthDayWindow(today, profile.WindowStartMonthDay, profile.WindowEndMonthDay, leadDays);

            var hasDateRule = targetTransplantDate.HasValue;
            var targetDateValue = targetTransplantDate.GetValueOrDefault();
            var daysUntilTargetDate = hasDateRule ? targetDateValue.DayNumber - today.DayNumber : (int?)null;

            var isDateReady = !hasDateRule || today >= targetDateValue;
            var isDateSoon = hasDateRule && !isDateReady && daysUntilTargetDate.HasValue && daysUntilTargetDate.Value <= leadDays;
            var isStreakReady = nightStreak >= requiredNights;

            var isRelevantNow = hasWindow ? (isInWindow || isWindowSoon) : (isDateReady || isDateSoon);
            var isActionNow = isRelevantNow && isStreakReady && (!hasWindow || isInWindow) && isDateReady;
            var isSoon = !isActionNow && (isRelevantNow || IsNearStreak(requiredNights, nightStreak));

            var statusLabel = isActionNow ? "Action now" : isSoon ? "Soon" : "Dormant";
            var badgeClass = isActionNow ? "text-bg-success" : isSoon ? "text-bg-warning" : "text-bg-secondary";

            var ruleExplanation = BuildRuleExplanation(requiredNights, nightStreak, useCoolingLogic, nightThresholdF);
            var timingExplanation = BuildTimingExplanation(hasWindow, isInWindow, isWindowSoon, daysUntilWindowStart, hasDateRule, daysUntilTargetDate);

            var guidance = BuildGuidance(statusLabel, targetTransplantDate, requiredNights, nightStreak, useCoolingLogic, nightThresholdF, timingExplanation);
            var actionTypeLabel = ResolveActionTypeLabel(profile.ActionType, useCoolingLogic, hasWindow, isInWindow, isWindowSoon);

            computedCards.Add(new PlantReadinessCard
            {
                DisplayName = profile.DisplayName,
                CategoriesLabel = FormatCategories(profile.Categories),
                ActionTypeLabel = actionTypeLabel,
                RequiredConsecutiveNights = requiredNights,
                CurrentNightStreak = nightStreak,
                NightTempThresholdF = nightThresholdF,
                StreakOperatorLabel = useCoolingLogic ? "<=" : ">=",
                TargetTransplantDate = targetTransplantDate,
                IndoorStartDate = indoorStartDate,
                StatusLabel = statusLabel,
                BadgeClass = badgeClass,
                RuleExplanation = ruleExplanation,
                TimingExplanation = timingExplanation,
                Guidance = guidance,
                Notes = profile.Notes
            });
        }

        plantReadinessCards = computedCards
            .OrderBy(c => GetStatusRank(c.StatusLabel))
            .ThenBy(c => c.DisplayName)
            .ToList();
    }

    private IEnumerable<PlantReadinessCard> GetVisiblePlantReadinessCards()
    {
        return showDormantCards
            ? plantReadinessCards
            : plantReadinessCards.Where(c => !c.StatusLabel.Equals("Dormant", StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<PlantReadinessCard> GetActionNowCards()
    {
        return GetVisiblePlantReadinessCards()
            .Where(c => c.StatusLabel.Equals("Action now", StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<PlantReadinessCard> GetSoonCards()
    {
        return GetVisiblePlantReadinessCards()
            .Where(c => c.StatusLabel.Equals("Soon", StringComparison.OrdinalIgnoreCase));
    }

    private static string ResolveActionTypeLabel(string? actionType, bool useCoolingLogic, bool hasWindow, bool isInWindow, bool isWindowSoon)
    {
        var normalizedAction = string.IsNullOrWhiteSpace(actionType)
            ? "plant"
            : actionType.Trim().ToLowerInvariant();

        // For bulbs/perennials, pre-window reminders are usually buying actions.
        if (normalizedAction == "plant" && useCoolingLogic && hasWindow && isWindowSoon && !isInWindow)
        {
            return "Buy";
        }

        return normalizedAction switch
        {
            "buy" => "Buy",
            "harvest" => "Harvest",
            "prep" => "Prep",
            _ => "Plant"
        };
    }

    private int CalculateNightStreak(double thresholdF, bool useCoolingLogic)
    {
        if (recentDailyMeasurements == null || recentDailyMeasurements.Count == 0)
        {
            return 0;
        }

        var streak = 0;
        foreach (var day in recentDailyMeasurements.OrderByDescending(d => d.TimestampMs))
        {
            var minF = ToFahrenheit(day.Fields.Temperature.Min);
            var matches = useCoolingLogic ? minF <= thresholdF : minF >= thresholdF;
            if (matches)
            {
                streak++;
            }
            else
            {
                break;
            }
        }

        return streak;
    }

    private static string BuildGuidance(string statusLabel, DateOnly? targetDate, int requiredNights, int currentNights, bool useCoolingLogic, double thresholdF, string timingExplanation)
    {
        var directionText = useCoolingLogic ? "at or below" : "at or above";

        if (statusLabel.Equals("Action now", StringComparison.OrdinalIgnoreCase))
        {
            return "Conditions look favorable to act now.";
        }

        if (statusLabel.Equals("Soon", StringComparison.OrdinalIgnoreCase))
        {
            return $"Monitor this plant closely. Need {requiredNights}-night streak {directionText} {thresholdF:F0}F (currently {currentNights}). {timingExplanation}";
        }

        return $"Outside active window right now. Next target timing is around {FormatGuidanceDate(targetDate)}.";
    }

    private static (bool HasWindow, bool IsInWindow, bool IsWindowSoon, int? DaysUntilStart) EvaluateMonthDayWindow(DateOnly today, string? startMonthDay, string? endMonthDay, int leadDays)
    {
        if (!TryParseMonthDay(startMonthDay, today.Year, out var start) || !TryParseMonthDay(endMonthDay, today.Year, out var end))
        {
            return (false, false, false, null);
        }

        var inWindow = IsDateWithinRange(today, start, end);
        if (inWindow)
        {
            return (true, true, false, 0);
        }

        var nextStart = GetNextOccurrence(today, startMonthDay!);
        var daysUntil = nextStart.DayNumber - today.DayNumber;
        var isSoon = daysUntil >= 0 && daysUntil <= leadDays;
        return (true, false, isSoon, daysUntil);
    }

    private static DateOnly GetNextOccurrence(DateOnly today, string monthDay)
    {
        if (!TryParseMonthDay(monthDay, today.Year, out var thisYearDate))
        {
            return today;
        }

        if (thisYearDate >= today)
        {
            return thisYearDate;
        }

        return TryParseMonthDay(monthDay, today.Year + 1, out var nextYearDate) ? nextYearDate : today;
    }

    private static bool IsDateWithinRange(DateOnly date, DateOnly start, DateOnly end)
    {
        if (start <= end)
        {
            return date >= start && date <= end;
        }

        return date >= start || date <= end;
    }

    private static bool TryParseMonthDay(string? monthDay, int year, out DateOnly date)
    {
        date = default;
        if (string.IsNullOrWhiteSpace(monthDay))
        {
            return false;
        }

        var composed = $"{year}-{monthDay}";
        return DateOnly.TryParseExact(composed, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out date);
    }

    private static bool IsNearStreak(int requiredNights, int currentNights)
    {
        if (requiredNights <= 0)
        {
            return true;
        }

        return currentNights >= Math.Max(0, requiredNights - 2);
    }

    private static int GetStatusRank(string status)
    {
        return status switch
        {
            "Action now" => 0,
            "Soon" => 1,
            _ => 2
        };
    }

    private static string BuildRuleExplanation(int requiredNights, int currentNights, bool useCoolingLogic, double thresholdF)
    {
        var operatorText = useCoolingLogic ? "<=" : ">=";
        return $"Night streak {currentNights}/{requiredNights} where night min {operatorText} {thresholdF:F0}F.";
    }

    private static string BuildTimingExplanation(bool hasWindow, bool isInWindow, bool isWindowSoon, int? daysUntilWindowStart, bool hasDateRule, int? daysUntilTargetDate)
    {
        if (hasWindow)
        {
            if (isInWindow)
            {
                return "Inside configured seasonal window.";
            }

            if (isWindowSoon && daysUntilWindowStart.HasValue)
            {
                return $"Window opens in {daysUntilWindowStart.Value} day(s).";
            }

            if (daysUntilWindowStart.HasValue)
            {
                return $"Window opens in {daysUntilWindowStart.Value} day(s).";
            }
        }

        if (hasDateRule && daysUntilTargetDate.HasValue)
        {
            if (daysUntilTargetDate.Value <= 0)
            {
                return "Date target has opened.";
            }

            return $"Date target opens in {daysUntilTargetDate.Value} day(s).";
        }

        return "No strict date window configured.";
    }

    private static string FormatGuidanceDate(DateOnly? date)
    {
        return date.HasValue ? date.Value.ToString("MMM d, yyyy") : "the recommended window";
    }

    private static string FormatCategories(List<string>? categories)
    {
        if (categories == null || categories.Count == 0)
        {
            return "Uncategorized";
        }

        return string.Join(", ", categories.Select(c => c.Trim()).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct(StringComparer.OrdinalIgnoreCase));
    }

    private static double ToFahrenheit(double celsius)
    {
        return 32 + (celsius * 9 / 5);
    }

    private static string FormatDateLabel(object value)
    {
        if (value is DateTime dateTime)
        {
            return dateTime.ToString("MM-dd");
        }

        return string.Empty;
    }

    private static string FormatSeasonDateLabel(object value)
    {
        if (value is DateTime dateTime)
        {
            return dateTime.ToString("MM-dd");
        }

        return string.Empty;
    }

    private static string FormatDate(DateOnly value)
    {
        return value.ToString("MMM d, yyyy");
    }

    private static string FormatNullableDate(DateOnly? value)
    {
        return value.HasValue ? FormatDate(value.Value) : "n/a";
    }

    private static string FormatUtcDateTime(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("yyyy-MM-dd HH:mm 'UTC'") : "n/a";
    }

    private static string GetPriorityBadgeClass(string priority)
    {
        if (priority.Equals("High", StringComparison.OrdinalIgnoreCase))
        {
            return "text-bg-danger";
        }

        if (priority.Equals("Medium", StringComparison.OrdinalIgnoreCase))
        {
            return "text-bg-warning";
        }

        return "text-bg-secondary";
    }

    private static string GetSeasonRegimeBadgeClass(string regime)
    {
        return regime switch
        {
            "False Spring Signal" => "text-bg-danger",
            "Spring Stabilizing" => "text-bg-success",
            "Cooling Pattern" => "text-bg-primary",
            "Warm Stable" => "text-bg-warning",
            "Insufficient Data" => "text-bg-secondary",
            _ => "text-bg-secondary"
        };
    }

    private class PlantReadinessCard
    {
        public string DisplayName { get; set; } = string.Empty;
        public string CategoriesLabel { get; set; } = string.Empty;
        public string ActionTypeLabel { get; set; } = string.Empty;
        public int RequiredConsecutiveNights { get; set; }
        public int CurrentNightStreak { get; set; }
        public double NightTempThresholdF { get; set; }
        public string StreakOperatorLabel { get; set; } = string.Empty;
        public DateOnly? TargetTransplantDate { get; set; }
        public DateOnly? IndoorStartDate { get; set; }
        public string StatusLabel { get; set; } = string.Empty;
        public string BadgeClass { get; set; } = string.Empty;
        public string RuleExplanation { get; set; } = string.Empty;
        public string TimingExplanation { get; set; } = string.Empty;
        public string Guidance { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
    }

    private class SeasonTrendPoint
    {
        public DateTime Date { get; set; }
        public double HighF { get; set; }
        public double LowF { get; set; }
        public double AverageF => (HighF + LowF) / 2.0;
    }
}
