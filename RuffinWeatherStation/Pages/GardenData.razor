@page "/garden-data"
@inject TemperatureService TemperatureService
@inject GardenDataService GardenDataService
@inject GardenPlantProfileService GardenPlantProfileService

<h1>Garden Data</h1>

<p class="text-muted">
    Garden-focused weather context, seasonal reference dates, and frost timing guidance for planning.
</p>

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Loading garden data...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-warning" role="alert">@errorMessage</div>
}
else
{
    <div class="row gy-3">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">Recent Rainfall (Last @recentRainfallDays Days)</h3>
                </div>
                <div class="card-body">
                    @if (rainfallAnalysis?.DailyRainfall != null && rainfallAnalysis.DailyRainfall.Any())
                    {
                        <div class="mb-3">
                            <div><strong>Total:</strong> @rainfallAnalysis.TotalRainfall.ToString("F1") mm</div>
                            <div><strong>Rainy Days:</strong> @rainfallAnalysis.RainyDaysCount / @recentRainfallDays</div>
                            <div><strong>Longest Dry Spell:</strong> @rainfallAnalysis.LongestDrySpellDays day(s)</div>
                        </div>

                        <RadzenChart class="garden-rain-chart">
                            <RadzenColumnSeries Data="@rainfallAnalysis.DailyRainfall"
                                                CategoryProperty="Timestamp"
                                                ValueProperty="Total"
                                                Title="Daily Rain (mm)"
                                                Fill="rgba(46, 139, 87, 0.75)" />
                            <RadzenCategoryAxis Formatter="@FormatDateLabel" />
                            <RadzenValueAxis>
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="Rainfall (mm)" />
                            </RadzenValueAxis>
                            <RadzenLegend Position="LegendPosition.Top" />
                        </RadzenChart>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No rainfall history is available for the selected period.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Season And Frost Reference</h3>
                </div>
                <div class="card-body">
                    @if (gardenReference != null)
                    {
                        <p class="mb-2"><strong>Location:</strong> @gardenReference.LocationLabel</p>
                        <p class="mb-3"><strong>Average Last Frost:</strong> @FormatDate(gardenReference.AverageLastFrostDate)</p>

                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Season</th>
                                    <th>Start Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>Spring</td><td>@FormatDate(gardenReference.SeasonStarts.Spring)</td></tr>
                                <tr><td>Summer</td><td>@FormatDate(gardenReference.SeasonStarts.Summer)</td></tr>
                                <tr><td>Fall</td><td>@FormatDate(gardenReference.SeasonStarts.Fall)</td></tr>
                                <tr><td>Winter</td><td>@FormatDate(gardenReference.SeasonStarts.Winter)</td></tr>
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Garden reference dates are unavailable right now.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h3 class="mb-0">Planning Windows</h3>
                </div>
                <div class="card-body">
                    @if (gardenReference != null)
                    {
                        <div class="row gy-2">
                            <div class="col-md-4">
                                <div class="p-3 border rounded h-100">
                                    <h5 class="mb-2">Seed Starting Window</h5>
                                    <p class="mb-1">
                                        @FormatDate(seedWindowStart) to @FormatDate(seedWindowEnd)
                                    </p>
                                    <small class="text-muted">Based on average last frost date.</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border rounded h-100">
                                    <h5 class="mb-2">Hose And Equipment Check</h5>
                                    <p class="mb-1">
                                        @FormatDate(hoseWindowStart) to @FormatDate(hoseWindowEnd)
                                    </p>
                                    <small class="text-muted">Centered around first day of spring.</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border rounded h-100">
                                    <h5 class="mb-2">Recent Temperature Pattern</h5>
                                    <p class="mb-1">
                                        Trend: @temperatureTrendSummary
                                    </p>
                                    <p class="mb-1">Frost Days (10 days): @recentFrostDays</p>
                                    <small class="text-muted">Computed from recent daily station aggregates.</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header bg-warning-subtle">
                    <h3 class="mb-0">Plant Readiness (JSON Rules)</h3>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(plantProfilesLoadError))
                    {
                        <div class="alert alert-warning mb-0">@plantProfilesLoadError</div>
                    }
                    else if (plantReadinessCards.Count == 0)
                    {
                        <p class="text-muted mb-0">No plant profile entries found. Add entries to `wwwroot/data/garden-plants.json`.</p>
                    }
                    else
                    {
                        <div class="row gy-3">
                            @foreach (var card in plantReadinessCards)
                            {
                                <div class="col-lg-4 col-md-6">
                                    <div class="p-3 border rounded h-100">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h5 class="mb-0">@card.DisplayName</h5>
                                                <small class="text-muted">@card.Category</small>
                                            </div>
                                            <span class="badge @card.BadgeClass">@card.StatusLabel</span>
                                        </div>

                                        <div class="small mb-2">
                                            <div><strong>Target transplant date:</strong> @FormatDate(card.TargetTransplantDate)</div>
                                            <div><strong>Indoor start target:</strong> @FormatDate(card.IndoorStartDate)</div>
                                            <div><strong>Warm streak:</strong> @card.CurrentWarmStreak / @card.RequiredWarmStreak days >= @card.RequiredTempF.ToString("F0")F</div>
                                        </div>

                                        <p class="mb-1">@card.Guidance</p>
                                        @if (!string.IsNullOrWhiteSpace(card.Notes))
                                        {
                                            <small class="text-muted">@card.Notes</small>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header bg-danger-subtle">
                    <h3 class="mb-0">Weather Risk Snapshot (NWS)</h3>
                </div>
                <div class="card-body">
                    @if (nwsAlertSummary == null)
                    {
                        <p class="text-muted mb-0">No NWS snapshot summary is currently available.</p>
                    }
                    else
                    {
                        <div class="row gy-2 mb-3">
                            <div class="col-md-3 col-6"><strong>Total Snapshots:</strong> @nwsAlertSummary.TotalSnapshots</div>
                            <div class="col-md-3 col-6"><strong>Active:</strong> @nwsAlertSummary.ActiveAlerts</div>
                            <div class="col-md-3 col-6"><strong>Expired:</strong> @nwsAlertSummary.ExpiredAlerts</div>
                            <div class="col-md-3 col-6"><strong>Severe/Extreme:</strong> @nwsAlertSummary.SevereOrExtremeAlerts</div>
                        </div>

                        @if (nwsAlertSummary.ActiveAlerts > 0 || nwsAlertSummary.SevereOrExtremeAlerts > 0)
                        {
                            <div class="alert alert-danger">
                                Elevated weather risk detected in the last @nwsAlertSummary.LookbackDays day(s). Consider securing loose equipment, checking drainage, and preparing protective covers.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success">
                                No high-risk NWS patterns detected in the selected lookback period.
                            </div>
                        }

                        @if (nwsAlertSummary.RecentAlerts.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Event</th>
                                            <th>Severity</th>
                                            <th>Status</th>
                                            <th>Sent</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var alert in nwsAlertSummary.RecentAlerts)
                                        {
                                            <tr>
                                                <td>@alert.Event</td>
                                                <td>@alert.Severity</td>
                                                <td>@(alert.IsActive ? "Active" : "Expired")</td>
                                                <td>@FormatUtcDateTime(alert.SentUtc)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="alert alert-secondary mb-0">
                Next phase options: add plant-specific mitigation playbooks and live NWS detail drill-down from snapshot IDs.
            </div>
        </div>
    </div>
}

<style>
    .garden-rain-chart {
        height: 260px;
    }

    @@media (max-width: 768px) {
        .garden-rain-chart {
            height: 220px;
        }
    }
</style>

@code {
    private const int recentRainfallDays = 15;
    private const int recentTemperaturePatternDays = 10;

    private bool isLoading = true;
    private string? errorMessage;

    private GardenReferenceData? gardenReference;
    private NwsAlertSummaryData? nwsAlertSummary;
    private WeatherAnalysisResult? rainfallAnalysis;
    private List<DailyMeasurement>? recentDailyMeasurements;
    private List<GardenPlantProfile> plantProfiles = new();
    private List<PlantReadinessCard> plantReadinessCards = new();
    private string? plantProfilesLoadError;

    private DateOnly seedWindowStart;
    private DateOnly seedWindowEnd;
    private DateOnly hoseWindowStart;
    private DateOnly hoseWindowEnd;
    private int recentFrostDays;
    private string temperatureTrendSummary = "Unknown";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var rainfallTask = TemperatureService.GetAnalysisAsync(recentRainfallDays, rainOnly: true);
            var dailyTask = TemperatureService.GetDailyMeasurementsAsync(recentTemperaturePatternDays);
            var referenceTask = GardenDataService.GetGardenReferenceAsync();
            var plantProfilesTask = GardenPlantProfileService.GetProfilesAsync();
            var alertsTask = GardenDataService.GetAlertsSummaryAsync(days: 7);

            await Task.WhenAll(rainfallTask, dailyTask, referenceTask, plantProfilesTask, alertsTask);

            rainfallAnalysis = rainfallTask.Result;
            recentDailyMeasurements = dailyTask.Result;
            gardenReference = referenceTask.Result;
            plantProfiles = plantProfilesTask.Result.Profiles;
            plantProfilesLoadError = plantProfilesTask.Result.ErrorMessage;
            nwsAlertSummary = alertsTask.Result;

            if (gardenReference == null)
            {
                errorMessage = "Unable to load garden reference data from the API.";
                return;
            }

            CalculatePlanningWindows();
            CalculateTemperaturePattern();
            BuildPlantReadinessCards();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load garden data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculatePlanningWindows()
    {
        if (gardenReference == null)
        {
            return;
        }

        seedWindowStart = gardenReference.AverageLastFrostDate.AddDays(-42);
        seedWindowEnd = gardenReference.AverageLastFrostDate.AddDays(-14);

        hoseWindowStart = gardenReference.SeasonStarts.Spring.AddDays(-14);
        hoseWindowEnd = gardenReference.SeasonStarts.Spring.AddDays(14);
    }

    private void CalculateTemperaturePattern()
    {
        if (recentDailyMeasurements == null || recentDailyMeasurements.Count == 0)
        {
            temperatureTrendSummary = "No daily measurements";
            recentFrostDays = 0;
            return;
        }

        var ordered = recentDailyMeasurements.OrderBy(d => d.TimestampMs).ToList();
        var firstAvg = ordered.First().Fields.Temperature.Avg;
        var lastAvg = ordered.Last().Fields.Temperature.Avg;
        var trendDelta = lastAvg - firstAvg;

        if (trendDelta > 1.0)
        {
            temperatureTrendSummary = $"Warming ({trendDelta:F1}C)";
        }
        else if (trendDelta < -1.0)
        {
            temperatureTrendSummary = $"Cooling ({Math.Abs(trendDelta):F1}C)";
        }
        else
        {
            temperatureTrendSummary = "Stable";
        }

        recentFrostDays = ordered.Count(d => d.Fields.Temperature.Min <= 0);
    }

    private void BuildPlantReadinessCards()
    {
        plantReadinessCards.Clear();

        if (gardenReference == null || plantProfiles.Count == 0)
        {
            return;
        }

        foreach (var profile in plantProfiles)
        {
            var targetTransplantDate = gardenReference.AverageLastFrostDate.AddDays(profile.DaysAfterLastFrostToTransplant);
            var indoorStartDate = gardenReference.AverageLastFrostDate.AddDays(-profile.DaysBeforeLastFrostToStartIndoors);

            var warmStreak = CalculateWarmStreak(profile.MinSoilTempF);
            var requiredStreak = Math.Max(1, profile.RequiredConsecutiveDaysAtOrAboveTemp);

            var isDateReady = DateOnly.FromDateTime(DateTime.Today) >= targetTransplantDate;
            var isStreakReady = warmStreak >= requiredStreak;

            var statusLabel = isDateReady && isStreakReady ? "Ready" : "Hold";
            var badgeClass = isDateReady && isStreakReady ? "text-bg-success" : "text-bg-secondary";

            var guidance = BuildGuidance(isDateReady, isStreakReady, targetTransplantDate, requiredStreak, warmStreak);

            plantReadinessCards.Add(new PlantReadinessCard
            {
                DisplayName = profile.DisplayName,
                Category = profile.Category,
                RequiredTempF = profile.MinSoilTempF,
                RequiredWarmStreak = requiredStreak,
                CurrentWarmStreak = warmStreak,
                TargetTransplantDate = targetTransplantDate,
                IndoorStartDate = indoorStartDate,
                StatusLabel = statusLabel,
                BadgeClass = badgeClass,
                Guidance = guidance,
                Notes = profile.Notes
            });
        }
    }

    private int CalculateWarmStreak(double minTempF)
    {
        if (recentDailyMeasurements == null || recentDailyMeasurements.Count == 0)
        {
            return 0;
        }

        var streak = 0;
        foreach (var day in recentDailyMeasurements.OrderByDescending(d => d.TimestampMs))
        {
            var avgF = ToFahrenheit(day.Fields.Temperature.Avg);
            if (avgF >= minTempF)
            {
                streak++;
            }
            else
            {
                break;
            }
        }

        return streak;
    }

    private static string BuildGuidance(bool isDateReady, bool isStreakReady, DateOnly targetDate, int requiredStreak, int currentStreak)
    {
        if (isDateReady && isStreakReady)
        {
            return "Conditions look favorable for transplanting now.";
        }

        if (!isDateReady && !isStreakReady)
        {
            return $"Wait until at least {targetDate:MMM d, yyyy} and build a {requiredStreak}-day warm streak (currently {currentStreak}).";
        }

        if (!isDateReady)
        {
            return $"Temperatures are trending warm enough, but frost-date timing suggests waiting until {targetDate:MMM d, yyyy}.";
        }

        return $"Calendar timing is open, but hold until warm streak reaches {requiredStreak} day(s).";
    }

    private static double ToFahrenheit(double celsius)
    {
        return 32 + (celsius * 9 / 5);
    }

    private static string FormatDateLabel(object value)
    {
        if (value is DateTime dateTime)
        {
            return dateTime.ToString("MM-dd");
        }

        return string.Empty;
    }

    private static string FormatDate(DateOnly value)
    {
        return value.ToString("MMM d, yyyy");
    }

    private static string FormatUtcDateTime(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("yyyy-MM-dd HH:mm 'UTC'") : "n/a";
    }

    private class PlantReadinessCard
    {
        public string DisplayName { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public double RequiredTempF { get; set; }
        public int RequiredWarmStreak { get; set; }
        public int CurrentWarmStreak { get; set; }
        public DateOnly TargetTransplantDate { get; set; }
        public DateOnly IndoorStartDate { get; set; }
        public string StatusLabel { get; set; } = string.Empty;
        public string BadgeClass { get; set; } = string.Empty;
        public string Guidance { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
    }
}
