@page "/garden-data"
@inject TemperatureService TemperatureService
@inject GardenDataService GardenDataService
@inject GardenPlantProfileService GardenPlantProfileService
@inject IJSRuntime JSRuntime

<h1>Garden Data</h1>

<p class="text-muted">
    Garden-focused weather context, seasonal reference dates, and frost timing guidance for planning.
</p>

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Loading garden data...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-warning" role="alert">@errorMessage</div>
}
else
{
    <div class="row gy-3">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0"><span class="rain-emoji" aria-hidden="true">🌧️</span> Recent Rainfall (Last @recentRainfallDays Days)</h3>
                </div>
                <div class="card-body">
                    @if (rainfallAnalysis?.DailyRainfall != null && rainfallAnalysis.DailyRainfall.Any())
                    {
                        <div class="mb-3">
                            <div><strong>Total:</strong> @FormatRainfallMillimetersAndInches(rainfallAnalysis.TotalRainfall)</div>
                            <div><strong>Average Per Day:</strong> @FormatRainfallMillimetersAndInches(rainfallAnalysis.AverageDailyRainfall)</div>
                            <div><strong>Rainy Days:</strong> @rainfallAnalysis.RainyDaysCount / @recentRainfallDays</div>
                            <div><strong>Longest Dry Spell:</strong> @rainfallAnalysis.LongestDrySpellDays day(s)</div>
                        </div>

                        <div class="d-flex justify-content-end mb-2">
                            <span class="badge rainfall-intensity-badge @GetRainIntensityBadgeClass(rainfallAnalysis)">
                                Rain intensity: @GetRainIntensityLabel(rainfallAnalysis)
                            </span>
                        </div>

                        <RadzenChart class="garden-rain-chart" @key="RainChartRenderKey">
                            <RadzenColumnSeries Data="@rainfallAnalysis.DailyRainfall"
                                                CategoryProperty="Timestamp"
                                                ValueProperty="Total"
                                                Title="Daily rain (mm / in)"
                                                Fill="rgba(46, 139, 87, 0.75)" />
                            <RadzenCategoryAxis Formatter="@FormatDateLabel" />
                            <RadzenValueAxis>
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="Rainfall (mm / in)" />
                            </RadzenValueAxis>
                            <RadzenLegend Position="LegendPosition.Top" />
                        </RadzenChart>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No rainfall history is available for the selected period.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Season And Frost Reference</h3>
                </div>
                <div class="card-body">
                    @if (gardenReference != null)
                    {
                        <p class="mb-2"><strong>Location:</strong> @gardenReference.LocationLabel</p>
                        <p class="mb-3"><strong>Average Last Frost:</strong> @FormatDate(gardenReference.AverageLastFrostDate)</p>

                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Season</th>
                                    <th>Start Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>Spring</td><td>@FormatDate(gardenReference.SeasonStarts.Spring)</td></tr>
                                <tr><td>Summer</td><td>@FormatDate(gardenReference.SeasonStarts.Summer)</td></tr>
                                <tr><td>Fall</td><td>@FormatDate(gardenReference.SeasonStarts.Fall)</td></tr>
                                <tr><td>Winter</td><td>@FormatDate(gardenReference.SeasonStarts.Winter)</td></tr>
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Garden reference dates are unavailable right now.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h3 class="mb-0">Planning Windows</h3>
                </div>
                <div class="card-body">
                    @if (gardenReference != null)
                    {
                        <div class="row gy-2">
                            <div class="col-md-4">
                                <div class="p-3 border rounded h-100">
                                    <h5 class="mb-2">Seed Starting Window</h5>
                                    <p class="mb-1">
                                        @FormatDate(seedWindowStart) to @FormatDate(seedWindowEnd)
                                    </p>
                                    <small class="text-muted">Based on average last frost date.</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border rounded h-100">
                                    <h5 class="mb-2">Hose And Equipment Check</h5>
                                    <p class="mb-1">
                                        @FormatDate(hoseWindowStart) to @FormatDate(hoseWindowEnd)
                                    </p>
                                    <small class="text-muted">Centered around first day of spring.</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border rounded h-100">
                                    <h5 class="mb-2">Recent Temperature Pattern</h5>
                                    <p class="mb-1">
                                        Trend: @temperatureTrendSummary
                                    </p>
                                    <p class="mb-1">Frost Days (10 days): @recentFrostDays</p>
                                    <small class="text-muted">Computed from recent daily station aggregates.</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info-subtle d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">Season Transition Signal</h3>
                    <span class="badge @GetSeasonRegimeBadgeClass(seasonRegimeLabel)">@seasonRegimeLabel</span>
                </div>
                <div class="card-body">
                    @if (seasonTrendData.Count == 0)
                    {
                        <p class="text-muted mb-0">Not enough recent daily data to evaluate seasonal transition patterns.</p>
                    }
                    else
                    {
                        <div class="row gy-2 mb-3">
                            <div class="col-md-4 col-12">
                                <strong>Confidence:</strong> @seasonRegimeConfidence%
                            </div>
                            <div class="col-md-8 col-12">
                                <strong>Why:</strong> @seasonRegimeWhy
                            </div>
                            @if (seasonForecastData.Count > 0)
                            {
                                <div class="col-12">
                                    <small class="text-muted"><strong>Forecast overlay:</strong> @seasonForecastOverlaySummary</small>
                                </div>
                            }
                        </div>

                        <div class="season-signal-summary mb-3" aria-label="Season signal counts from recent days">
                            <button type="button"
                                    class="badge season-signal-pill warm @(showWarmSignalSeries ? string.Empty : "is-off")"
                                    aria-pressed="@showWarmSignalSeries"
                                    title="Toggle warm threshold and warm signal markers"
                                    @onclick="ToggleWarmSignalSeriesAsync">
                                Warm hits: @seasonWarmSignalHits / @seasonSignalWindowDays
                            </button>
                            <button type="button"
                                    class="badge season-signal-pill cold @(showColdSignalSeries ? string.Empty : "is-off")"
                                    aria-pressed="@showColdSignalSeries"
                                    title="Toggle cold threshold and cold signal markers"
                                    @onclick="ToggleColdSignalSeriesAsync">
                                Cold hits: @seasonColdSignalHits / @seasonSignalWindowDays
                            </button>
                            <button type="button"
                                    class="badge season-signal-pill swing @(showSwingSignalSeries ? string.Empty : "is-off")"
                                    aria-pressed="@showSwingSignalSeries"
                                    title="Toggle large-swing signal markers"
                                    @onclick="ToggleSwingSignalSeriesAsync">
                                Swing days: @seasonLargeSwingSignalHits / @seasonSignalWindowDays
                            </button>
                        </div>

                        <RadzenChart class="season-trend-chart" @key="SeasonChartRenderKey">
                            <RadzenLineSeries Data="@seasonTrendData"
                                              CategoryProperty="Date"
                                              ValueProperty="HighC"
                                              Title="Daily High (°C)"
                                              LineType="LineType.Solid"
                                              StrokeWidth="3" />
                            <RadzenLineSeries Data="@seasonTrendData"
                                              CategoryProperty="Date"
                                              ValueProperty="LowC"
                                              Title="Daily Low (°C)"
                                              LineType="LineType.Dashed"
                                              StrokeWidth="2" />
                            <RadzenLineSeries Data="@seasonTrendData"
                                              CategoryProperty="Date"
                                              ValueProperty="AverageC"
                                              Title="Daily Avg (°C)"
                                              LineType="LineType.Dotted"
                                              StrokeWidth="2" />
                            <RadzenLineSeries Data="@seasonTrendData"
                                              CategoryProperty="Date"
                                              ValueProperty="RollingAverageC"
                                              Title="5-Day Rolling Avg (°C)"
                                              LineType="LineType.Solid"
                                              StrokeWidth="4" />
                            @if (showWarmSignalSeries)
                            {
                                <RadzenLineSeries Data="@seasonTrendData"
                                                  CategoryProperty="Date"
                                                  ValueProperty="WarmDayThresholdC"
                                                  Title="Warm Day Threshold (20.00°C)"
                                                  LineType="LineType.Dotted"
                                                  StrokeWidth="1" />
                                @if (seasonWarmSignalPoints.Count > 0)
                                {
                                    <RadzenLineSeries Data="@seasonWarmSignalPoints"
                                                      CategoryProperty="Date"
                                                      ValueProperty="ValueC"
                                                      Title="Warm Signal Days"
                                                      LineType="LineType.Dotted"
                                                      StrokeWidth="0" />
                                }
                            }
                            @if (showColdSignalSeries)
                            {
                                <RadzenLineSeries Data="@seasonTrendData"
                                                  CategoryProperty="Date"
                                                  ValueProperty="ColdNightThresholdC"
                                                  Title="Cold Night Threshold (2.22°C)"
                                                  LineType="LineType.Dotted"
                                                  StrokeWidth="1" />
                                @if (seasonColdSignalPoints.Count > 0)
                                {
                                    <RadzenLineSeries Data="@seasonColdSignalPoints"
                                                      CategoryProperty="Date"
                                                      ValueProperty="ValueC"
                                                      Title="Cold Signal Nights"
                                                      LineType="LineType.Dotted"
                                                      StrokeWidth="0" />
                                }
                            }
                            @if (showSwingSignalSeries && seasonSwingSignalPoints.Count > 0)
                            {
                                <RadzenLineSeries Data="@seasonSwingSignalPoints"
                                                  CategoryProperty="Date"
                                                  ValueProperty="ValueC"
                                                  Title="Large Swing Days"
                                                  LineType="LineType.Dotted"
                                                  StrokeWidth="0" />
                            }
                            @if (seasonForecastData.Count > 0)
                            {
                                <RadzenLineSeries Data="@seasonForecastData"
                                                  CategoryProperty="Date"
                                                  ValueProperty="ForecastHighC"
                                                  Title="Forecast High (12-24h)"
                                                  LineType="LineType.Dashed"
                                                  StrokeWidth="3" />
                                <RadzenLineSeries Data="@seasonForecastData"
                                                  CategoryProperty="Date"
                                                  ValueProperty="ForecastLowC"
                                                  Title="Forecast Low (12-24h)"
                                                  LineType="LineType.Dashed"
                                                  StrokeWidth="3" />
                            }
                            <RadzenCategoryAxis Formatter="@FormatSeasonDateLabel" />
                            <RadzenValueAxis>
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="Temperature (°C)" />
                            </RadzenValueAxis>
                            <RadzenLegend Position="LegendPosition.Top" />
                        </RadzenChart>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header bg-warning-subtle">
                    <h3 class="mb-0">Plant Readiness (JSON Rules)</h3>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="showDormantCardsToggle" @bind="showDormantCards" />
                        <label class="form-check-label" for="showDormantCardsToggle">Show dormant cards (debug)</label>
                    </div>

                    @if (plantProfileWarnings.Any())
                    {
                        <div class="alert alert-warning mb-3">
                            <strong>Profile validation warnings:</strong>
                            <ul class="mb-0 mt-2">
                                @foreach (var warning in plantProfileWarnings)
                                {
                                    <li>@warning</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(plantProfilesLoadError))
                    {
                        <div class="alert alert-warning mb-0">@plantProfilesLoadError</div>
                    }
                    else if (plantReadinessCards.Count == 0)
                    {
                        <p class="text-muted mb-0">No plant profile entries found. Add entries to `wwwroot/data/garden-plants.json`.</p>
                    }
                    else
                    {
                        @if (!GetVisiblePlantReadinessCards().Any())
                        {
                            <div class="alert alert-secondary mb-0">
                                No actionable cards right now. Turn on `Show dormant cards` to inspect inactive entries.
                            </div>
                        }
                        else
                        {
                            @if (GetActionNowCards().Any())
                            {
                                <h5 class="mb-3">Do This Now</h5>
                                <div class="row gy-3 mb-4">
                                    @foreach (var card in GetActionNowCards())
                                    {
                                        <div class="col-lg-4 col-md-6">
                                            <div class="p-3 border rounded h-100 plant-readiness-card season-tone-@card.SeasonTone">
                                                <div class="season-card-header @card.SeasonHeaderClass" aria-label="@($"{card.SeasonLabel} category")">
                                                    <span class="season-emoji" aria-hidden="true">@card.SeasonEmoji</span>
                                                    <span class="season-label">@card.SeasonLabel</span>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <div>
                                                        <h5 class="mb-0">@card.DisplayName</h5>
                                                        <div class="plant-meta-strip">
                                                            <small class="text-muted">@card.CategoriesLabel · @card.ActionTypeLabel</small>
                                                        </div>
                                                    </div>
                                                    <span class="badge status-badge @card.BadgeClass">@card.StatusLabel</span>
                                                </div>

                                                <div class="small mb-2">
                                                    <div><strong>Target transplant date:</strong> @FormatNullableDate(card.TargetTransplantDate)</div>
                                                    <div><strong>Indoor start target:</strong> @FormatNullableDate(card.IndoorStartDate)</div>
                                                    <div class="science-text"><strong>Night streak:</strong> @FormatNightStreakForDisplay(card.CurrentNightStreak, card.RequiredConsecutiveNights, card.SupportsSuccessionPlanting) nights @card.StreakOperatorLabel @FormatTemperaturePair(card.NightTempThresholdC, "F2", "F0")</div>
                                                    @{
                                                        var streakPercent = GetNightStreakPercent(card.CurrentNightStreak, card.RequiredConsecutiveNights);
                                                        var streakAriaLabel = $"Night streak progress for {card.DisplayName}: {card.CurrentNightStreak} out of {card.RequiredConsecutiveNights} nights ({streakPercent} percent).";
                                                    }
                                                    <div class="progress night-streak-progress mt-1"
                                                         role="progressbar"
                                                         aria-label="@streakAriaLabel"
                                                         aria-valuenow="@streakPercent"
                                                         aria-valuemin="0"
                                                         aria-valuemax="100">
                                                        <div class="progress-bar @GetNightStreakProgressClass(card.StatusLabel)"
                                                             style="width: @streakPercent%;">
                                                            @if (streakPercent >= 20)
                                                            {
                                                                <span class="night-streak-progress-label">@streakPercent%</span>
                                                            }
                                                            <span class="visually-hidden">@streakAriaLabel</span>
                                                        </div>
                                                    </div>
                                                    @if (streakPercent < 20)
                                                    {
                                                        <div class="night-streak-progress-caption text-muted">@streakPercent%</div>
                                                    }
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(card.RuleExplanation))
                                                {
                                                    <div class="small text-muted mb-1 science-text"><strong>Rule:</strong> @card.RuleExplanation</div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(card.TimingExplanation))
                                                {
                                                    <div class="small text-muted mb-2"><strong>Timing:</strong> @card.TimingExplanation</div>
                                                }

                                                <p class="mb-1 science-text">@card.Guidance</p>
                                                @if (!string.IsNullOrWhiteSpace(card.Notes))
                                                {
                                                    <small class="text-muted">@card.Notes</small>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @if (GetSoonCards().Any())
                            {
                                <h5 class="mb-3">Prepare Soon</h5>
                                <div class="row gy-3">
                                    @foreach (var card in GetSoonCards())
                                    {
                                        <div class="col-lg-4 col-md-6">
                                            <div class="p-3 border rounded h-100 plant-readiness-card season-tone-@card.SeasonTone">
                                                <div class="season-card-header @card.SeasonHeaderClass" aria-label="@($"{card.SeasonLabel} category")">
                                                    <span class="season-emoji" aria-hidden="true">@card.SeasonEmoji</span>
                                                    <span class="season-label">@card.SeasonLabel</span>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <div>
                                                        <h5 class="mb-0">@card.DisplayName</h5>
                                                        <div class="plant-meta-strip">
                                                            <small class="text-muted">@card.CategoriesLabel · @card.ActionTypeLabel</small>
                                                        </div>
                                                    </div>
                                                    <span class="badge status-badge @card.BadgeClass">@card.StatusLabel</span>
                                                </div>

                                                <div class="small mb-2">
                                                    <div><strong>Target transplant date:</strong> @FormatNullableDate(card.TargetTransplantDate)</div>
                                                    <div><strong>Indoor start target:</strong> @FormatNullableDate(card.IndoorStartDate)</div>
                                                    <div class="science-text"><strong>Night streak:</strong> @FormatNightStreakForDisplay(card.CurrentNightStreak, card.RequiredConsecutiveNights, card.SupportsSuccessionPlanting) nights @card.StreakOperatorLabel @FormatTemperaturePair(card.NightTempThresholdC, "F2", "F0")</div>
                                                    @{
                                                        var streakPercent = GetNightStreakPercent(card.CurrentNightStreak, card.RequiredConsecutiveNights);
                                                        var streakAriaLabel = $"Night streak progress for {card.DisplayName}: {card.CurrentNightStreak} out of {card.RequiredConsecutiveNights} nights ({streakPercent} percent).";
                                                    }
                                                    <div class="progress night-streak-progress mt-1"
                                                         role="progressbar"
                                                         aria-label="@streakAriaLabel"
                                                         aria-valuenow="@streakPercent"
                                                         aria-valuemin="0"
                                                         aria-valuemax="100">
                                                        <div class="progress-bar @GetNightStreakProgressClass(card.StatusLabel)"
                                                             style="width: @streakPercent%;">
                                                            @if (streakPercent >= 20)
                                                            {
                                                                <span class="night-streak-progress-label">@streakPercent%</span>
                                                            }
                                                            <span class="visually-hidden">@streakAriaLabel</span>
                                                        </div>
                                                    </div>
                                                    @if (streakPercent < 20)
                                                    {
                                                        <div class="night-streak-progress-caption text-muted">@streakPercent%</div>
                                                    }
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(card.RuleExplanation))
                                                {
                                                    <div class="small text-muted mb-1 science-text"><strong>Rule:</strong> @card.RuleExplanation</div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(card.TimingExplanation))
                                                {
                                                    <div class="small text-muted mb-2"><strong>Timing:</strong> @card.TimingExplanation</div>
                                                }

                                                <p class="mb-1 science-text">@card.Guidance</p>
                                                @if (!string.IsNullOrWhiteSpace(card.Notes))
                                                {
                                                    <small class="text-muted">@card.Notes</small>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @if (showDormantCards && GetDormantCards().Any())
                            {
                                <h5 class="mb-3 mt-4">Dormant (Debug)</h5>
                                <div class="row gy-3">
                                    @foreach (var card in GetDormantCards())
                                    {
                                        <div class="col-lg-4 col-md-6">
                                            <div class="p-3 border rounded h-100 plant-readiness-card season-tone-@card.SeasonTone">
                                                <div class="season-card-header @card.SeasonHeaderClass" aria-label="@($"{card.SeasonLabel} category")">
                                                    <span class="season-emoji" aria-hidden="true">@card.SeasonEmoji</span>
                                                    <span class="season-label">@card.SeasonLabel</span>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <div>
                                                        <h5 class="mb-0">@card.DisplayName</h5>
                                                        <div class="plant-meta-strip">
                                                            <small class="text-muted">@card.CategoriesLabel · @card.ActionTypeLabel</small>
                                                        </div>
                                                    </div>
                                                    <span class="badge status-badge @card.BadgeClass">@card.StatusLabel</span>
                                                </div>

                                                <div class="small mb-2">
                                                    <div><strong>Target transplant date:</strong> @FormatNullableDate(card.TargetTransplantDate)</div>
                                                    <div><strong>Indoor start target:</strong> @FormatNullableDate(card.IndoorStartDate)</div>
                                                    <div class="science-text"><strong>Night streak:</strong> @FormatNightStreakForDisplay(card.CurrentNightStreak, card.RequiredConsecutiveNights, card.SupportsSuccessionPlanting) nights @card.StreakOperatorLabel @FormatTemperaturePair(card.NightTempThresholdC, "F2", "F0")</div>
                                                    @{
                                                        var streakPercent = GetNightStreakPercent(card.CurrentNightStreak, card.RequiredConsecutiveNights);
                                                        var streakAriaLabel = $"Night streak progress for {card.DisplayName}: {card.CurrentNightStreak} out of {card.RequiredConsecutiveNights} nights ({streakPercent} percent).";
                                                    }
                                                    <div class="progress night-streak-progress mt-1"
                                                         role="progressbar"
                                                         aria-label="@streakAriaLabel"
                                                         aria-valuenow="@streakPercent"
                                                         aria-valuemin="0"
                                                         aria-valuemax="100">
                                                        <div class="progress-bar @GetNightStreakProgressClass(card.StatusLabel)"
                                                             style="width: @streakPercent%;">
                                                            @if (streakPercent >= 20)
                                                            {
                                                                <span class="night-streak-progress-label">@streakPercent%</span>
                                                            }
                                                            <span class="visually-hidden">@streakAriaLabel</span>
                                                        </div>
                                                    </div>
                                                    @if (streakPercent < 20)
                                                    {
                                                        <div class="night-streak-progress-caption text-muted">@streakPercent%</div>
                                                    }
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(card.RuleExplanation))
                                                {
                                                    <div class="small text-muted mb-1 science-text"><strong>Rule:</strong> @card.RuleExplanation</div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(card.TimingExplanation))
                                                {
                                                    <div class="small text-muted mb-2"><strong>Timing:</strong> @card.TimingExplanation</div>
                                                }

                                                <p class="mb-1 science-text">@card.Guidance</p>
                                                @if (!string.IsNullOrWhiteSpace(card.Notes))
                                                {
                                                    <small class="text-muted">@card.Notes</small>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header bg-danger-subtle">
                    <h3 class="mb-0">Weather Risk Snapshot (NWS)</h3>
                </div>
                <div class="card-body">
                    @if (nwsAlertSummary == null)
                    {
                        <p class="text-muted mb-0">No NWS snapshot summary is currently available.</p>
                    }
                    else
                    {
                        <div class="row gy-2 mb-3">
                            <div class="col-md-3 col-6"><strong>Total Snapshots:</strong> @nwsAlertSummary.TotalSnapshots</div>
                            <div class="col-md-3 col-6"><strong>Active Alerts:</strong> @nwsAlertSummary.ActiveAlerts</div>
                            <div class="col-md-3 col-6"><strong>Expired Alerts:</strong> @nwsAlertSummary.ExpiredAlerts</div>
                            <div class="col-md-3 col-6"><strong>Severe/Extreme:</strong> @nwsAlertSummary.SevereOrExtremeAlerts</div>
                        </div>

                        <div class="small text-muted mb-3">
                            Active/expired counts are alert totals from the latest snapshot, not snapshot totals.
                        </div>

                        <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
                            <div><strong>Snapshot Fetched:</strong> @FormatUtcDateTime(nwsAlertSummary.SnapshotFetchedAtUtc)</div>
                            <div>
                                <strong>Snapshot Status:</strong>
                                @if (nwsAlertSummary.ActiveAlerts > 0)
                                {
                                    <span class="badge text-bg-success ms-1">Active Alerts</span>
                                }
                                else if (nwsAlertSummary.ExpiredAlerts > 0 || nwsAlertSummary.IsSnapshotExpired)
                                {
                                    <span class="badge text-bg-secondary ms-1">Expired Alerts</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-light ms-1">No Active Alerts</span>
                                }
                            </div>
                        </div>

                        @if (nwsAlertSummary.ActiveAlerts > 0 || nwsAlertSummary.SevereOrExtremeAlerts > 0)
                        {
                            <div class="alert alert-danger">
                                Elevated weather risk detected in the last @nwsAlertSummary.LookbackDays day(s). Consider securing loose equipment, checking drainage, and preparing protective covers.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success">
                                No high-risk NWS patterns detected in the selected lookback period.
                            </div>
                        }

                        @if (nwsAlertSummary.RecentAlerts.Any())
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var alert in nwsAlertSummary.RecentAlerts)
                                {
                                    <div class="border rounded p-3">
                                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                            <div>
                                                <h6 class="mb-1">@alert.Event</h6>
                                                <div class="text-muted">@alert.Headline</div>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <span class="badge text-bg-primary">@alert.Severity</span>
                                                <span class="badge @(alert.IsActive ? "text-bg-success" : "text-bg-secondary")">@(alert.IsActive ? "Active" : "Expired")</span>
                                            </div>
                                        </div>

                                        <div class="row gy-2 mb-2">
                                            <div class="col-md-3 col-6"><strong>Urgency:</strong> @alert.Urgency</div>
                                            <div class="col-md-3 col-6"><strong>Certainty:</strong> @alert.Certainty</div>
                                            <div class="col-md-3 col-6"><strong>Onset:</strong> @FormatUtcDateTime(alert.OnsetUtc)</div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(alert.Instruction))
                                        {
                                            <div class="alert alert-warning py-2 mb-2">
                                                <strong>Instruction:</strong> @alert.Instruction
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(alert.Description))
                                        {
                                            <details>
                                                <summary>Description</summary>
                                                <div class="mt-2" style="white-space: pre-wrap;">@alert.Description</div>
                                            </details>
                                        }

                                        <div class="mt-2 small text-muted">
                                            @if (!string.IsNullOrWhiteSpace(alert.SourceUrl))
                                            {
                                                <a href="@alert.SourceUrl" target="_blank" rel="noopener noreferrer">Open source alert</a>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(alert.AlertId))
                                            {
                                                <span>Alert ID: @alert.AlertId</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (nwsAlertSummary.MitigationRecommendations.Any())
                        {
                            <hr />
                            <h5 class="mb-3">Mitigation Playbook</h5>
                            <div class="row gy-2">
                                @foreach (var recommendation in nwsAlertSummary.MitigationRecommendations)
                                {
                                    <div class="col-md-6">
                                        <div class="border rounded p-3 h-100">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <strong>@recommendation.Category</strong>
                                                <span class="badge @GetPriorityBadgeClass(recommendation.Priority)">@recommendation.Priority</span>
                                            </div>
                                            <p class="mb-0">@recommendation.Guidance</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

    </div>
}
