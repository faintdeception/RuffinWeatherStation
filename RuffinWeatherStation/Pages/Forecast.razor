@page "/forecast"
@inject GardenDataService GardenDataService

<h1>NWS Forecast</h1>
<p class="text-muted">Full forecast details from the latest National Weather Service snapshot.</p>

@if (isLoading)
{
    <div class="text-center my-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 mb-0">Loading forecast data...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-warning">@loadError</div>
}
else
{
    <NwsForecastCard Forecast="forecastSummary"
                     Title="National Weather Service Forecast"
                     Subtitle="Expanded planning view with detailed period guidance"
                     MaxItems="10"
                     ShowDetailed="true"
                     ShowSnapshotMeta="true" />
}

@code {
    private NwsForecastData? forecastSummary;
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            loadError = null;
            forecastSummary = await GardenDataService.GetForecastSummaryAsync(maxPeriods: 12);
        }
        catch (Exception ex)
        {
            loadError = $"Unable to load forecast data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
