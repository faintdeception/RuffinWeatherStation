@page "/weather-home"
@page "/home"

<h1>Current Weather Dashboard</h1>
<div class="alert alert-info text-center mb-4" style="border-left: 5px solid #17a2b8;">
    <div class="d-flex align-items-center justify-content-center">
        <div>
            <h4 class="alert-heading mb-1">RWS</h4>
            <p class="mb-2">v2.2</p>            
            <p class="mb-0">Latest update: Weatherbot remembers recent weather reports and has generally increased
                awareness with weather alerts from the national weather service.
            </p>
        </div>
    </div>
</div>
@if (prediction != null)
{
    <div class="alert alert-info mb-4">
        <div class="d-flex align-items-start">
            <div style="font-size: 2rem; margin-right: 15px;">weather robot v6.4</div>
            <div>
                <h5 class="alert-heading">Weather Reporting Generated By meta-llama/Llama-3.1-70B-Instruct</h5>
                <p class="mb-0">@prediction.Reasoning</p>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <small class="text-muted">Created: @FormatDateTimeForUserWithTimezone(prediction.CreatedAt) | Confidence: @prediction.ConfidencePercentage</small>
                </div>
            </div>
        </div>
    </div>
}

@if (isAlertSummaryLoading)
{
    <div class="alert alert-light border mb-4">
        <strong>Weather Attention Alerts:</strong> Checking latest NWS snapshot...
    </div>
}
else if (!string.IsNullOrWhiteSpace(alertSummaryLoadError))
{
    <div class="alert alert-warning mb-4">
        <strong>Weather Attention Alerts:</strong> @alertSummaryLoadError
    </div>
}
else if (attentionAlerts.Any())
{
    <div class="card border-danger mb-4">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Weather Attention Alerts</h4>
            <span class="badge text-bg-light">@attentionAlerts.Count</span>
        </div>
        <div class="card-body">
            @if (homeAlertSummary?.SnapshotFetchedAtUtc.HasValue == true)
            {
                <p class="text-muted mb-2">
                    Snapshot fetched: @FormatDateTimeForUserWithTimezone(homeAlertSummary.SnapshotFetchedAtUtc.Value)
                    @if (homeAlertSummary.IsSnapshotExpired)
                    {
                        <span class="badge text-bg-secondary ms-2">Snapshot Expired</span>
                    }
                    else
                    {
                        <span class="badge text-bg-success ms-2">Snapshot Active</span>
                    }
                </p>
            }

            <div class="d-flex flex-column gap-3">
                @foreach (var alert in attentionAlerts)
                {
                    <div class="border rounded p-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <h5 class="mb-1">@alert.Event</h5>
                                @if (!string.IsNullOrWhiteSpace(alert.Headline))
                                {
                                    <div class="text-muted">@alert.Headline</div>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <span class="badge @GetHomeSeverityBadgeClass(alert.Severity)">@alert.Severity</span>
                                <span class="badge @(alert.IsActive ? "text-bg-success" : "text-bg-secondary")">@(alert.IsActive ? "Active" : "Expired")</span>
                            </div>
                        </div>

                        <div class="row gy-2 small">
                            <div class="col-md-4 col-6"><strong>Urgency:</strong> @alert.Urgency</div>
                            <div class="col-md-4 col-6"><strong>Certainty:</strong> @alert.Certainty</div>
                            <div class="col-md-4 col-12"><strong>Onset:</strong> @FormatNullableDateTimeForUserWithTimezone(alert.OnsetUtc)</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(alert.Instruction))
                        {
                            <div class="alert alert-warning py-2 mt-2 mb-0">
                                <strong>Instruction:</strong> @alert.Instruction
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="mb-1">Real-time weather data from the Ruffin Weather Station</p>
        @if (!string.IsNullOrEmpty(userTimeZone))
        {
            <small class="text-muted">📍 Times shown in: @userTimeZone</small>
        }
    </div>
    
</div>

<div class="card border-warning mb-4" style="max-width: 700px;">
    <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <h5 class="card-title mb-1">All-Time Records</h5>
            <p class="card-text mb-0">See the highest temperature, wind speed, and daily rainfall ever recorded at this station.</p>
        </div>
        <a class="btn btn-outline-primary" href="all-time-records">View All-Time Records</a>
    </div>
</div>

@if (isLoading && measurement?.Fields == null)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Loading weather data...</p>
    </div>
}
else if (measurement == null)
{
    <div class="alert alert-warning" role="alert">
        No weather data available. Please try refreshing.
    </div>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <div class="card" style="max-width: 400px;">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="mb-0">Temperature</h3>
                        <div>
                            <span class="badge @(IsDataStale() ? "bg-warning" : "bg-success")">
                                @(IsDataStale() ? "Data may be stale" : "Data current")
                            </span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="display-1 text-center">@FormatDouble(measurement.Fields?.Temperature)°C</div>
                    <div class="h4 text-center">@FormatTemperatureF(measurement.Fields?.Temperature)°F</div>
                    <p class="text-center text-muted">
                        Last updated: @FormatDateTimeForUserWithTimezone(measurement.TimestampMs)
                        @if (IsDataStale())
                        {
                            <span class="text-warning d-block">Data is @GetDataAge() old</span>
                        }
                        @if (nextCacheRefresh.HasValue)
                        {
                            <small class="d-block mt-1">Next data refresh in approximately @GetTimeUntilCacheRefresh()</small>
                        }
                    </p>
                    <hr />
                    <table class="table table-sm">
                        <tr><th>Humidity</th><td>@FormatDouble(measurement.Fields?.Humidity)%</td></tr>
                        <tr><th>Dewpoint</th><td>@FormatDouble(measurement.Fields?.Dewpoint)°C</td></tr>
                        <tr><th>Pressure</th><td>@FormatDouble(measurement.Fields?.Pressure) hPa</td></tr>
                        <tr><th>Light</th><td>@FormatDouble(measurement.Fields?.Lux) lux</td></tr>
                        <tr><th>Wind</th><td>@FormatDouble(measurement.Fields?.WindSpeed) m/s (@measurement.Fields?.WindDirectionCardinal)</td></tr>
                        <tr><th>Rain Today</th><td>@accumulatedRainfall.ToString("F1") mm</td></tr>
                        <tr><th>Location</th><td>@measurement.Tags?.Location</td></tr>
                        <tr><th>Sensor</th><td>@measurement.Tags?.SensorType</td></tr>
                    </table>
                </div>
            </div>

            <div class="card mt-3" style="max-width: 400px;">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Historical High / Low</h3>
                    <small class="rainfall-card-subtitle">Daily record for selected date</small>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="historicalDateInput">Date</label>
                        <input id="historicalDateInput"
                               type="date"
                               class="form-control"
                               value="@selectedHistoricalDate.ToString("yyyy-MM-dd")"
                               @onchange="OnHistoricalDateChanged" />
                        <small class="text-muted d-block mt-1">Location: @historicalLocation</small>
                    </div>

                    @if (isHistoricalDailyLoading)
                    {
                        <p class="text-muted mb-0">Loading historical record...</p>
                    }
                    else if (!string.IsNullOrEmpty(historicalDailyErrorMessage))
                    {
                        <div class="alert alert-warning mb-0">@historicalDailyErrorMessage</div>
                    }
                    else if (historicalDailyRecord?.HasData == true)
                    {
                        <div class="row text-center mb-3">
                            <div class="col-6">
                                <h6 class="mb-1">High</h6>
                                <div class="fw-semibold">@FormatDouble(historicalDailyRecord.High?.Value)C</div>
                                <small class="text-muted">@FormatTemperatureF(historicalDailyRecord.High?.Value)F</small>
                                <div><small class="text-muted">@FormatHistoricDate(historicalDailyRecord.High?.Date)</small></div>
                            </div>
                            <div class="col-6">
                                <h6 class="mb-1">Low</h6>
                                <div class="fw-semibold">@FormatDouble(historicalDailyRecord.Low?.Value)C</div>
                                <small class="text-muted">@FormatTemperatureF(historicalDailyRecord.Low?.Value)F</small>
                                <div><small class="text-muted">@FormatHistoricDate(historicalDailyRecord.Low?.Date)</small></div>
                            </div>
                        </div>

                        <div class="text-muted">
                            <small>Updated: @(historicalDailyRecord.UpdatedAt.HasValue ? FormatDateTimeForUserWithTimezone(historicalDailyRecord.UpdatedAt.Value) : "N/A")</small>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            No historical record for this date.
                        </div>
                    }
                </div>
            </div>

            <WindRoseCard Measurement="measurement"
                          ObservedLabel="@(measurement != null ? FormatDateTimeForUserWithTimezone(measurement.TimestampMs) : null)" />

            <div class="card mt-3 today-rainfall-card" style="max-width: 400px;">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">Today's Rainfall Accumulation</h3>
                    <small class="rainfall-card-subtitle">@DateTime.Now.ToString("D")</small>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3 rainfall-summary">
                        <div class="display-6">@accumulatedRainfall.ToString("F1") mm</div>
                        <p class="mb-1">Total rainfall today</p>
                        <small class="text-muted">Since @(firstMeasurementTime.HasValue ? FormatDateTimeForUser(firstMeasurementTime.Value) : "N/A")</small>
                        <div class="text-muted">Elapsed: @Math.Round(elapsedRainfallTime.TotalHours, 1) hr</div>
                    </div>

                    @if (rainfallData != null && rainfallData.Any())
                    {
                        <RadzenChart class="rainfall-chart">
                            <RadzenAreaSeries Data="@rainfallData"
                                              CategoryProperty="Timestamp"
                                              ValueProperty="AccumulatedRain"
                                              Title="Accumulation (mm)"
                                              Smooth="true"
                                              Fill="rgba(54, 162, 235, 0.3)"
                                              StrokeWidth="2">
                            </RadzenAreaSeries>
                            <RadzenColumnSeries Data="@rainfallData"
                                                CategoryProperty="Timestamp"
                                                ValueProperty="RainIncrement"
                                                Title="Increment (mm)"
                                                Fill="rgba(54, 162, 235, 0.7)">
                            </RadzenColumnSeries>
                            <RadzenCategoryAxis Formatter="@FormatRainfallTimestamp" />
                            <RadzenValueAxis>
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="Rainfall (mm)" />
                            </RadzenValueAxis>
                            <RadzenLegend Position="LegendPosition.Top" />
                        </RadzenChart>
                    }
                    else
                    {
                        <p class="text-muted text-center mb-0">No rainfall measurements recorded for today yet.</p>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
            @if (showShortTermAnalysis)
            {
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h3 class="mb-0">Recent Weather Analysis</h3>
                            <div>
                                <button @onclick="() => AnalyzeRecentPeriod(1)" class="btn btn-outline-light @(analysisHours == 1 ? "active" : "")">1 Hour</button>
                                <button @onclick="() => AnalyzeRecentPeriod(6)" class="btn btn-outline-light @(analysisHours == 6 ? "active" : "")">6 Hours</button>
                                <button @onclick="() => AnalyzeRecentPeriod(12)" class="btn btn-outline-light @(analysisHours == 12 ? "active" : "")">12 Hours</button>
                                <button @onclick="() => AnalyzeRecentPeriod(24)" class="btn btn-outline-light @(analysisHours == 24 ? "active" : "")">24 Hours</button>
                                <button @onclick="SwitchToLongTermAnalysis" class="btn btn-outline-light ms-2">Long-term</button>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (IsDeviceOffline())
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle"></i> 
                                Warning: Weather station appears to be offline. Data shown may not be current.
                            </div>
                        }
                        
                        @if (recentAnalysisResult == null || !recentAnalysisResult.Success)
                        {
                            <p><em>Loading analysis data...</em></p>
                            @if (recentAnalysisResult?.ErrorMessage != null)
                            {
                                <div class="alert alert-warning">@recentAnalysisResult.ErrorMessage</div>
                            }
                        }
                        else
                        {
                            <div class="row mb-2">
                                <div class="col-12">
                                    <div class="alert alert-info">
                                        <strong>Analysis Period:</strong> @FormatDateTimeForUser(recentAnalysisResult.StartDate) to @FormatDateTimeForUser(recentAnalysisResult.EndDate)
                                        <br/>
                                        <strong>Measurements:</strong> @recentAnalysisResult.MeasurementCount data points (avg. @recentAnalysisResult.SampleRate min between samples)
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <div class="card bg-light">
                                        <div class="card-body text-center">
                                            <h5>Temperature</h5>
                                            <div class="display-6">@FormatDouble(recentAnalysisResult.AverageTemperature)°C</div>
                                            <div>High: @FormatDouble(recentAnalysisResult.HighestTemperature)°C</div>
                                            <div>Low: @FormatDouble(recentAnalysisResult.LowestTemperature)°C</div>
                                            <div class="mt-2">
                                                @if (recentAnalysisResult.TemperatureTrend > 0.1)
                                                {
                                                    <span class="badge bg-danger">Rising (@FormatDouble(recentAnalysisResult.TemperatureTrend)°C)</span>
                                                }
                                                else if (recentAnalysisResult.TemperatureTrend < -0.1)
                                                {
                                                    <span class="badge bg-info">Falling (@FormatDouble(Math.Abs(recentAnalysisResult.TemperatureTrend))°C)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Stable</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card bg-light">
                                        <div class="card-body text-center">
                                            <h5>Pressure</h5>
                                            <div class="display-6">@FormatDouble(recentAnalysisResult.AveragePressure) hPa</div>
                                            <div>High: @FormatDouble(recentAnalysisResult.HighestPressure) hPa</div>
                                            <div>Low: @FormatDouble(recentAnalysisResult.LowestPressure) hPa</div>
                                            <div class="mt-2">
                                                @if (recentAnalysisResult.PressureTrend > 0.5)
                                                {
                                                    <span class="badge bg-warning">Rising (@FormatDouble(recentAnalysisResult.PressureTrend) hPa)</span>
                                                }
                                                else if (recentAnalysisResult.PressureTrend < -0.5)
                                                {
                                                    <span class="badge bg-primary">Falling (@FormatDouble(Math.Abs(recentAnalysisResult.PressureTrend)) hPa)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Stable</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <h4>Temperature Trend (Last @analysisHours hour@(analysisHours == 1 ? "" : "s"))</h4>
                            <div class="mb-4">
                                @if (recentAnalysisResult.HourlyTemperatures != null && recentAnalysisResult.HourlyTemperatures.Any())
                                {
                                    <RadzenChart>
                                        <RadzenLineSeries Smooth="true" Data="@recentAnalysisResult.HourlyTemperatures" 
                                                        CategoryProperty="Timestamp" 
                                                        ValueProperty="Temperature" 
                                                        Title="Temperature (°C)" 
                                                        LineType="LineType.Solid"
                                                        StrokeWidth="3">
                                            <RadzenMarkers MarkerType="MarkerType.Circle" Size="4" />
                                        </RadzenLineSeries>
                                        <RadzenCategoryAxis Formatter="@FormatTimestamp"></RadzenCategoryAxis>
                                        <RadzenValueAxis>
                                            <RadzenGridLines Visible="true" />
                                            <RadzenAxisTitle Text="Temperature (°C)" />
                                        </RadzenValueAxis>
                                        <RadzenLegend Position="LegendPosition.Top" />
                                    </RadzenChart>
                                }
                                else
                                {
                                    <p>No temperature data available for this period.</p>
                                }
                            </div>
                            
                            <h4>Pressure Trend (Last @analysisHours hour@(analysisHours == 1 ? "" : "s"))</h4>
                            <div class="mb-4">
                                @if (recentAnalysisResult.HourlyPressures != null && recentAnalysisResult.HourlyPressures.Any())
                                {
                                    <RadzenChart>
                                        <RadzenLineSeries Smooth="true" Data="@recentAnalysisResult.HourlyPressures" 
                                                        CategoryProperty="Timestamp" 
                                                        ValueProperty="Value" 
                                                        Title="Pressure (hPa)" 
                                                        StrokeWidth="3">
                                            <RadzenMarkers MarkerType="MarkerType.Circle" Size="4" />
                                        </RadzenLineSeries>
                                        <RadzenCategoryAxis Formatter="@FormatTimestamp"></RadzenCategoryAxis>
                                        <RadzenValueAxis Formatter="@FormatPressureValue">
                                            <RadzenGridLines Visible="true" />
                                            <RadzenAxisTitle Text="Pressure (hPa)" />
                                        </RadzenValueAxis>
                                    </RadzenChart>
                                }
                                else
                                {
                                    <p>No pressure data available for this period.</p>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="card mt-4 recent-rainfall-card">
                    <div class="card-header bg-info text-white">
                        <h3 class="mb-0">Recent rainfall</h3>
                        <small class="rainfall-card-subtitle">Daily accumulation for the last @recentRainfallDays days</small>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(recentRainfallErrorMessage))
                        {
                            <div class="alert alert-warning mb-0">@recentRainfallErrorMessage</div>
                        }
                        else if (recentRainfallAnalysis?.DailyRainfall != null && recentRainfallAnalysis.DailyRainfall.Any())
                        {
                            <div class="row mb-3 text-center">
                                <div class="col-sm-4 col-12 mb-2 mb-sm-0">
                                    <div class="fw-semibold">@recentRainfallAnalysis.TotalRainfall.ToString("F1") mm</div>
                                    <small class="text-muted">Total (15 days)</small>
                                </div>
                                <div class="col-sm-4 col-12 mb-2 mb-sm-0">
                                    <div class="fw-semibold">@recentRainfallAnalysis.AverageDailyRainfall.ToString("F1") mm</div>
                                    <small class="text-muted">Average per day</small>
                                </div>
                                <div class="col-sm-4 col-12">
                                    <div class="fw-semibold">@recentRainfallAnalysis.RainyDaysCount / @recentRainfallDays</div>
                                    <small class="text-muted">Days with rain</small>
                                </div>
                            </div>

                            <RadzenChart class="rainfall-chart">
                                <RadzenColumnSeries Data="@recentRainfallAnalysis.DailyRainfall"
                                                    CategoryProperty="Timestamp"
                                                    ValueProperty="Total"
                                                    Title="Daily accumulation (mm)"
                                                    Fill="rgba(30, 136, 229, 0.75)">
                                </RadzenColumnSeries>
                                <RadzenCategoryAxis Formatter="@FormatRecentRainfallDay" />
                                <RadzenValueAxis>
                                    <RadzenGridLines Visible="true" />
                                    <RadzenAxisTitle Text="Rainfall (mm)" />
                                </RadzenValueAxis>
                                <RadzenLegend Position="LegendPosition.Top" />
                            </RadzenChart>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No rainfall data available for the last @recentRainfallDays days.</p>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h3 class="mb-0">Long-term Weather Analysis</h3>
                            <div>
                                <button @onclick="() => AnalyzePeriod(7)" class="btn btn-outline-light @(analysisPeriod == 7 ? "active" : "")">7 Days</button>
                                <button @onclick="() => AnalyzePeriod(14)" class="btn btn-outline-light @(analysisPeriod == 14 ? "active" : "")">14 Days</button>
                                <button @onclick="() => AnalyzePeriod(30)" class="btn btn-outline-light @(analysisPeriod == 30 ? "active" : "")">30 Days</button>
                                <button @onclick="SwitchToShortTermAnalysis" class="btn btn-outline-light ms-2">Recent</button>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (analysisResult == null || !analysisResult.Success)
                        {
                            <p><em>Loading analysis data...</em></p>
                            @if (analysisResult?.ErrorMessage != null)
                            {
                                <div class="alert alert-warning">@analysisResult.ErrorMessage</div>
                            }
                        }
                        else
                        {
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <div class="card bg-light">
                                        <div class="card-body text-center">
                                            <h5>Temperature</h5>
                                            <div class="display-6">@FormatDouble(analysisResult.AverageTemperature)°C</div>
                                            <div>High: @FormatDouble(analysisResult.HighestTemperature)°C</div>
                                            <div>Low: @FormatDouble(analysisResult.LowestTemperature)°C</div>
                                            <div class="mt-2">
                                                @if (analysisResult.TemperatureTrend > 0.2)
                                                {
                                                    <span class="badge bg-danger">Warming trend</span>
                                                }
                                                else if (analysisResult.TemperatureTrend < -0.2)
                                                {
                                                    <span class="badge bg-info">Cooling trend</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Stable</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card bg-light">
                                        <div class="card-body text-center">
                                            <h5>Pressure</h5>
                                            <div class="display-6">@FormatDouble(analysisResult.AveragePressure) hPa</div>
                                            <div>High: @FormatDouble(analysisResult.HighestPressure) hPa</div>
                                            <div>Low: @FormatDouble(analysisResult.LowestPressure) hPa</div>
                                            <div class="mt-2">
                                                @if (analysisResult.PressureTrend > 1)
                                                {
                                                    <span class="badge bg-warning">Rising pressure</span>
                                                }
                                                else if (analysisResult.PressureTrend < -1)
                                                {
                                                    <span class="badge bg-primary">Falling pressure</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Stable</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <h5>Rainfall</h5>
                                            <div class="display-6">@analysisResult.TotalRainfall.ToString("0.0") mm</div>
                                            <div>Total rainfall across the period</div>
                                            @{
                                                var analyzedDays = analysisResult.DailyRainfall?.Count ?? analysisPeriod;
                                            }
                                            <div class="row text-center mt-3">
                                                <div class="col-sm-3 col-6 mb-3 mb-sm-0">
                                                    <div class="fw-semibold">@FormatDouble(analysisResult.AverageDailyRainfall) mm</div>
                                                    <small class="text-muted">Average per day</small>
                                                </div>
                                                <div class="col-sm-3 col-6 mb-3 mb-sm-0">
                                                    <div class="fw-semibold">@FormatDouble(analysisResult.MaxDailyRainfall) mm</div>
                                                    <small class="text-muted">Wettest day</small>
                                                </div>
                                                <div class="col-sm-3 col-6 mb-3 mb-sm-0">
                                                    <div class="fw-semibold">@analysisResult.RainyDaysCount / @analyzedDays</div>
                                                    <small class="text-muted">Days with rain</small>
                                                </div>
                                                <div class="col-sm-3 col-6">
                                                    <div class="fw-semibold">@analysisResult.LongestDrySpellDays day@(analysisResult.LongestDrySpellDays == 1 ? "" : "s")</div>
                                                    <small class="text-muted">Longest dry spell</small>
                                                </div>
                                            </div>
                                            <div class="mt-3">
                                                @if (analysisResult.RainTrend > 0.5)
                                                {
                                                    <span class="badge bg-primary">Rainfall increasing (+@FormatDouble(analysisResult.RainTrend) mm)</span>
                                                }
                                                else if (analysisResult.RainTrend < -0.5)
                                                {
                                                    <span class="badge bg-warning text-dark">Rainfall decreasing (-@FormatDouble(Math.Abs(analysisResult.RainTrend)) mm)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Rainfall trend stable</span>
                                                }
                                            </div>

                                            <div class="mt-4">
                                                @if (analysisResult.DailyRainfall != null && analysisResult.DailyRainfall.Any())
                                                {
                                                    <RadzenChart>
                                                        <RadzenColumnSeries Data="@analysisResult.DailyRainfall"
                                                                            CategoryProperty="Timestamp"
                                                                            ValueProperty="Total"
                                                                            Title="Daily rainfall (mm)"
                                                                            Fill="rgba(30, 136, 229, 0.7)">
                                                        </RadzenColumnSeries>
                                                        <RadzenLineSeries Data="@analysisResult.DailyRainfall"
                                                                          CategoryProperty="Timestamp"
                                                                          ValueProperty="MaxRate"
                                                                          Title="Peak rate (mm)"
                                                                          LineType="LineType.Dashed"
                                                                          StrokeWidth="2">
                                                            <RadzenMarkers MarkerType="MarkerType.Square" Size="4" />
                                                        </RadzenLineSeries>
                                                        <RadzenCategoryAxis Formatter="@FormatTimestamp"></RadzenCategoryAxis>
                                                        <RadzenValueAxis>
                                                            <RadzenGridLines Visible="true" />
                                                            <RadzenAxisTitle Text="Rainfall (mm)" />
                                                        </RadzenValueAxis>
                                                        <RadzenLegend Position="LegendPosition.Top" />
                                                    </RadzenChart>
                                                }
                                                else
                                                {
                                                    <p>No rainfall data available for this period.</p>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <h4>Temperature Trends</h4>
                            <div class="mb-4">
                                @if (analysisResult.HourlyTemperatures != null && analysisResult.HourlyTemperatures.Any())
                                {
                                    <RadzenChart>
                                        <RadzenAreaSeries Smooth="true" Data="@analysisResult.HourlyTemperatures" 
                                                        CategoryProperty="Timestamp" 
                                                        ValueProperty="Temperature" 
                                                        Title="Temperature (°C)" 
                                                        Fill="rgba(54, 162, 235, 0.2)">
                                    </RadzenAreaSeries>
                                    <RadzenLineSeries Smooth="true" Data="@analysisResult.HourlyTemperatures" 
                                                        CategoryProperty="Timestamp" 
                                                        ValueProperty="Max" 
                                                        Title="Maximum (°C)" 
                                                        LineType="LineType.Dashed">
                                    </RadzenLineSeries>
                                    <RadzenLineSeries Smooth="true" Data="@analysisResult.HourlyTemperatures" 
                                                        CategoryProperty="Timestamp" 
                                                        ValueProperty="Min" 
                                                        Title="Minimum (°C)" 
                                                        LineType="LineType.Dashed">
                                    </RadzenLineSeries>
                                    <RadzenCategoryAxis Formatter="@FormatTimestamp"></RadzenCategoryAxis>
                                    <RadzenValueAxis>
                                        <RadzenGridLines Visible="true" />
                                        <RadzenAxisTitle Text="Temperature (°C)" />
                                    </RadzenValueAxis>
                                    <RadzenLegend Position="LegendPosition.Top" />
                                </RadzenChart>
                                }
                                else
                                {
                                    <p>No temperature trend data available for this period.</p>
                                }
                            </div>
                            
                            <h4>Pressure Trends</h4>
                            <div class="mb-4">
                                @if (analysisResult.HourlyPressures != null && analysisResult.HourlyPressures.Any())
                                {
                                    <RadzenChart>
                                        <RadzenLineSeries Smooth="true" Data="@analysisResult.HourlyPressures" 
                                                        CategoryProperty="Timestamp" 
                                                        ValueProperty="Value" 
                                                        Title="Pressure (hPa)" 
                                                        StrokeWidth="3">
                                            <RadzenMarkers MarkerType="MarkerType.Circle" Size="4" />
                                        </RadzenLineSeries>
                                        <RadzenCategoryAxis Formatter="@FormatTimestamp"></RadzenCategoryAxis>
                                        <RadzenValueAxis Formatter="@FormatPressureValue">
                                            <RadzenGridLines Visible="true" />
                                            <RadzenAxisTitle Text="Pressure (hPa)" />
                                        </RadzenValueAxis>
                                    </RadzenChart>
                                }
                                else
                                {
                                    <p>No pressure trend data available for this period.</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

