{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "REPLACE_WITH_YOUR_JWT_SIGNING_KEY"
  },
  "ConnectionStrings": {
    "MongoDb": "REPLACE_WITH_YOUR_MONGODB_CONNECTION_STRING",
    "CosmosDb": "REPLACE_WITH_YOUR_COSMOSDB_CONNECTION_STRING"
  },
  "DatabaseSettings": {
    "DatabaseName": "weather_data",
    "Collections": {
      "Measurements": "measurements",
      "HourlyMeasurements": "hourly_measurements",
      "DailyMeasurements": "daily_measurements",
      "DailyDateRecords": "daily_date_records",
      "NwsSnapshots": "nws_snapshots",
      "Records": "records"
    }
  },
  "GardenSettings": {
    "AverageLastFrostMonthDay": "04-15",
    "LocationLabel": "backyard"
  },
  "NwsIconCache": {
    "RetentionDays": 1095,
    "CleanupIntervalHours": 24
  }
}